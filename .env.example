# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Group(s) to monitor, comma-separated (find the ids on the /whatsapp page)
CHANNEL_ID=120363xxxxxxxxxxxx@g.us
# Author whose messages become listings (…@c.us or …@lid). Empty = messages
# sent by the linked account itself.
OWNER_ID=393331112222@c.us

# ── Dashboard ────────────────────────────────────────────────────────────────
# Emails allowed to request a magic login link
AUTH_EMAILS=someone@example.com,other@example.com
# Public URL of the dashboard (used in magic links)
APP_URL=http://localhost:8080
# Seller name as it appears in WhatsApp .txt exports (Importa Chat page)
OWNER_DISPLAY_NAME=Alessandro Dalle Carbonare

# ── Mailgun (magic links + weekly DB backup) ─────────────────────────────────
# Without Mailgun the magic link is printed in the logs.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
BACKUP_TO=

# ── OpenRouter (optional LLM parsing/classification) ─────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Local run (docker-compose overrides these) ───────────────────────────────
# DB_PATH=data/wine.db
# HTTP_ADDR=:8080
