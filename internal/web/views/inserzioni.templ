package views

import "adesgo/internal/service"

type InserzioniData struct {
	Search   string
	Group    string // chat id filter ("" = all groups)
	Groups   map[string]string
	GroupIDs []string
	Rows     []service.CampaignRow
	SelChat  string
	SelKey   string
	Selected *service.Campaign
	Replies  []service.ReplyView
	Clients  []string // customer names for "Aggiungi risposta"

	TitleJob   service.TitleStatus
	LLMEnabled bool

	// "Controlla risposte" (conversation page)
	Review    *service.CampaignReview
	ReviewJob service.ReviewStatus

	// the inserzioni before / after the selected one in the list (nil at the ends)
	Prev, Next *service.CampaignRow
}

// listQuery keeps the list filters across list ↔ conversation navigation.
func (d InserzioniData) listQuery() string {
	v := q("q", d.Search, "g", d.Group)
	if v == "" {
		return ""
	}
	return "?" + v
}

func convURL(d InserzioniData, r service.CampaignRow) string {
	return "/inserzioni?" + q("chat", r.ChatID, "c", r.Key, "q", d.Search, "g", d.Group)
}

templ Inserzioni(d InserzioniData) {
	@Layout("Inserzioni", "inserzioni") {
		<div class="row between">
			<h2>Inserzioni</h2>
			<div id="title-job">
				@TitleJobStatus(d.TitleJob, d.LLMEnabled)
			</div>
		</div>
		<form class="filters" onsubmit="return false">
			<input
				type="search"
				name="q"
				value={ d.Search }
				placeholder="Cerca per Vino"
				hx-get="/inserzioni/list"
				hx-trigger="input changed delay:300ms, search"
				hx-target="#ins-list"
				hx-include="closest form"
			/>
			if len(d.GroupIDs) > 1 {
				<select name="g" hx-get="/inserzioni/list" hx-target="#ins-list" hx-include="closest form">
					<option value="">Tutti i gruppi</option>
					for _, id := range d.GroupIDs {
						<option value={ id } selected?={ id == d.Group }>{ d.Groups[id] }</option>
					}
				</select>
			}
		</form>
		<div id="ins-list">
			@InserzioniList(d)
		</div>
	}
}

// TitleJobStatus shows the LLM title button, or the progress while the job
// runs (polling every 3s). Saved titles appear in the list once it finishes.
templ TitleJobStatus(st service.TitleStatus, enabled bool) {
	if st.Running {
		<div class="job" hx-get="/inserzioni/titles" hx-trigger="every 3s" hx-target="#title-job">
			<span class="muted">Normalizzazione titoli… { itoa(st.Done) } / { itoa(st.Total) }</span>
		</div>
	} else {
		<div class="job">
			if st.Message != "" {
				<span class="muted">{ st.Message }</span>
			}
			if enabled {
				<button
					class="btn"
					hx-post="/inserzioni/titles"
					hx-target="#title-job"
					title="Genera con l'LLM un titolo breve per le inserzioni senza titolo (quelle rinominate a mano non vengono toccate)"
				>
					Normalizza titoli
					@IconSparkles()
				</button>
			}
		</div>
	}
}

// InserzioniList: the campaigns as a monthly timeline (by first post),
// like Ordini.
templ InserzioniList(d InserzioniData) {
	if len(d.Rows) == 0 {
		@Alert("info", "Nessuna inserzione.")
	} else {
		<p class="muted">Clicca su un'inserzione per aprire la conversazione.</p>
		<div class="view-timeline timeline">
			for _, m := range service.InserzioniMonths(d.Rows) {
				<section class="month">
					<header class="month-head">
						<h3>{ monthLabel(m.Year, m.Month) }</h3>
						<span class="muted">
							{ plural(len(m.Rows), "inserzione", "inserzioni") } · { plural(m.Risposte, "risposta", "risposte") }
						</span>
					</header>
					<div class="month-items">
						for _, r := range m.Rows {
							<a class={ "dl-item", "dl-link", templ.KV("dl-empty", r.Risposte == 0), templ.KV("dl-ordered", r.HasOrders) } href={ templ.URL(convURL(d, r)) }>
								<span class="dl-day">{ dayMonthShort(r.Data) }</span>
								<span class="dl-main">
									<b class="dl-title" title={ r.DisplayTitle }>{ r.DisplayTitle }</b>
									<span class="muted dl-group">
										{ r.ChatName }
										if r.LastData != "" && dateIT(r.LastData) != dateIT(r.Data) {
											· agg. { dateIT(r.LastData) }
										}
									</span>
								</span>
								<span class="dl-stats">
									if r.HasOrders {
										<span class="sr-only">con ordini ricevuti</span>
									}
									if r.Orphan {
										<span class="badge badge-warn">non monitorato</span>
									}
									if r.Consegna != "" {
										<span class="badge badge-info">Consegna { dayMonthShort(r.Consegna) }</span>
									}
								</span>
							</a>
						}
					</div>
				</section>
			}
		</div>
	}
}

templ InserzioneDetail(d InserzioniData) {
	@Layout("Inserzione", "inserzioni") {
		<div class="page-head">
			<a href={ templ.URL("/inserzioni" + d.listQuery()) } class="btn">← Elenco</a>
			<h2>
				if d.Selected != nil {
					{ d.Selected.DisplayTitle }
				} else {
					Conversazione
				}
			</h2>
			<nav class="prev-next" aria-label="Altre inserzioni">
				@neighborLink(d, d.Prev, "Inserzione precedente", true)
				@neighborLink(d, d.Next, "Inserzione successiva", false)
			</nav>
		</div>
		<div id="conv" class="conv">
			@Conversation(d)
		</div>
		@ModalSlot(false)
	}
}

// Conversation: the listing on the left, the replies on the right.
// neighborLink opens the previous/next inserzione of the list; disabled at
// the ends of the list.
templ neighborLink(d InserzioniData, r *service.CampaignRow, label string, left bool) {
	if r != nil {
		<a href={ templ.URL(convURL(d, *r)) } class="btn icon-btn" title={ label + ": " + r.DisplayTitle } aria-label={ label }>
			if left {
				@IconChevronLeft()
			} else {
				@IconChevronRight()
			}
		</a>
	} else {
		<button type="button" class="btn icon-btn" disabled aria-label={ label }>
			if left {
				@IconChevronLeft()
			} else {
				@IconChevronRight()
			}
		</button>
	}
}

templ Conversation(d InserzioniData) {
	if d.Selected == nil {
		@Alert("info", "Inserzione non trovata.")
	} else {
		<div class="conv-grid">
			<section class="conv-listing">
				<form class="rename col-head" hx-post="/inserzioni/rename" hx-target="#conv">
					<input type="hidden" name="chat" value={ d.SelChat }/>
					<input type="hidden" name="c" value={ d.SelKey }/>
					<label class="grow">
						Titolo inserzione
						<input type="text" name="title" value={ d.Selected.DisplayTitle }/>
					</label>
					<button type="submit" class="btn">Rinomina</button>
				</form>
				@deliveryField(d)
				<div class="listing-box">
					<strong>{ noEmoji(d.Selected.Venditore) }</strong> · { d.Selected.Data }
					<div class="listing-text">{ noEmoji(d.Selected.Testo) }</div>
				</div>
			</section>
			<section class="conv-replies">
				@OrderMismatch(d.Review)
				if len(d.Replies) == 0 {
					<p class="muted">Nessuna risposta.</p>
				} else {
					<div class="col-head">
						<label class="grow">
							@ReplyCounts(d, false)
							<input type="search" placeholder="Cerca per Cliente" data-filter=".reply"/>
						</label>
					</div>
					if d.LLMEnabled {
						@ReviewBar(d)
					}
					@ReviewFilter(d, false)
					<div class="replies" data-replies>
						for _, r := range d.Replies {
							@ReplyItem(d, r, false)
						}
						<p class="muted flag-empty">Nessuna risposta da verificare.</p>
					</div>
				}
				@AddReplyForm(d)
			</section>
		</div>
	}
}

// deliveryField: the vendor's estimated delivery date for the campaign,
// saved on change (app.js [data-autosave]) and copied to the linked order.
templ deliveryField(d InserzioniData) {
	<div class="delivery col-head">
		<label class="grow">
			Consegna stimata
			<input
				type="date"
				name="value"
				value={ d.Selected.Consegna }
				aria-label="Consegna stimata"
				data-autosave
				hx-post="/inserzioni/consegna"
				hx-trigger="change"
				hx-swap="none"
				hx-vals={ templ.JSONString(map[string]string{"chat": d.SelChat, "c": d.SelKey}) }
			/>
		</label>
	</div>
}

// AddReplyForm: a reply typed in by hand, for a message WhatsApp never
// delivered to the app. Collapsed until needed.
templ AddReplyForm(d InserzioniData) {
	<details class="add-reply">
		<summary class="btn">＋ Aggiungi risposta</summary>
		<form hx-post="/inserzioni/reply" hx-target="#conv" hx-swap="innerHTML">
			<input type="hidden" name="chat" value={ d.SelChat }/>
			<input type="hidden" name="c" value={ d.SelKey }/>
			<fieldset class="add-panel stack">
				<legend>Richiesta su altra chat WhatsApp</legend>
				<div class="add-reply-row">
					<label>
						Cliente
						<input type="text" name="cliente" list="reply-clients" placeholder="Scrivi per cercare un cliente..." autocomplete="off" required/>
					</label>
					<label>
						Data e ora
						<input type="datetime-local" name="ora" value={ nowMinute() } required/>
					</label>
				</div>
				<label>
					Messaggio
					<textarea name="testo" rows="2" placeholder="Es. 2 grazie" required></textarea>
				</label>
				<div class="form-end">
					<button type="submit" class="btn primary">Aggiungi risposta</button>
				</div>
			</fieldset>
			<datalist id="reply-clients">
				for _, c := range d.Clients {
					<option value={ c }></option>
				}
			</datalist>
		</form>
	</details>
}

// OrderMismatch warns when the campaign's order doesn't match the options of
// the listing (an option missing, another price): confirming orders against
// it would record the wrong wines or prices.
templ OrderMismatch(rv *service.CampaignReview) {
	if rv != nil && len(rv.Mismatch) > 0 {
		<div class="alert alert-warning order-mismatch" role="alert">
			<b>Attenzione: l'ordine { rv.QuotationNumber } non corrisponde all'inserzione.</b>
			<ul>
				for _, m := range rv.Mismatch {
					<li>{ noEmoji(m) }</li>
				}
			</ul>
			<span>Le risposte confermate userebbero le opzioni e i prezzi dell'ordine: non confermare finché l'ordine non è corretto.</span>
		</div>
	}
}

// ── "Controlla risposte" ─────────────────────────────────────────────────────

func reviewVals(d InserzioniData) string {
	return q("chat", d.SelChat, "c", d.SelKey)
}

func openChecks(rs []service.ReplyView) int {
	n := 0
	for _, r := range rs {
		if r.Check.Open() {
			n++
		}
	}
	return n
}

// reviewed: some reply has been checked (the filter stays, even at 0 to check).
func reviewed(rs []service.ReplyView) bool {
	for _, r := range rs {
		if r.Check != nil {
			return true
		}
	}
	return false
}

func kindLabel(kind string) string {
	if kind == "ambigua" {
		return "Ambigua"
	}
	return "Dubbia"
}

// proposalRows splits the options into those shown at once and those behind
// "Altre opzioni": with many options, only the proposed ones are open.
func proposalRows(rv *service.CampaignReview, qty map[string]int) (shown, more []service.OrderOption) {
	if len(qty) == 0 || len(rv.Options) <= 4 {
		return rv.Options, nil
	}
	for _, o := range rv.Options {
		if _, ok := qty[o.Key]; ok {
			shown = append(shown, o)
		} else {
			more = append(more, o)
		}
	}
	return shown, more
}

// proposalQty prefills the editor: the LLM's proposal, else what the rules
// read from the reply.
func proposalQty(rv *service.CampaignReview, r service.ReplyView) map[string]int {
	if r.Check != nil && r.Check.Proposal != "" {
		return rv.ProposalQty(r.Check.Proposal)
	}
	return rv.ProposalQty(r.Reading)
}

func qtyValue(qty map[string]int, key string) string {
	if v, ok := qty[key]; ok {
		return itoa(v)
	}
	return ""
}

func overrideLabel(o string) string {
	if o == "-" {
		return "Non è un ordine"
	}
	return "Ordine: " + o
}

// ReplyCounts: "64 risposte · 12 ordini" (refreshed out-of-band after a correction).
templ ReplyCounts(d InserzioniData, oob bool) {
	<span id="reply-counts" { oobAttrs(oob)... }>
		{ itoa(len(d.Replies)) } risposte
		if n := orderReplies(d.Replies); n > 0 {
			· { plural(n, "ordine", "ordini") }
		}
	</span>
}

// ReviewBar: the LLM check button, its progress (polling while it runs) and
// the outcome of the last run.
templ ReviewBar(d InserzioniData) {
	if st := d.ReviewJob; st.Running {
		<div
			id="review-bar"
			class="review-bar running"
			hx-get={ "/inserzioni/review?" + reviewVals(d) }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
			role="status"
		>
			<span class="spinner" aria-hidden="true"></span>
			<span class="review-msg">
				if st.For(d.SelChat, d.SelKey) {
					<b>Controllo delle risposte in corso…</b>
					<span class="muted">
						if st.Total > 0 {
							blocco { itoa(min(st.Done+1, st.Total)) } di { itoa(st.Total) }
						} else {
							preparazione
						}
						if st.Flagged > 0 {
							· { plural(st.Flagged, "da verificare", "da verificare") } finora
						}
					</span>
				} else {
					<b>È in corso il controllo di un'altra inserzione.</b>
					<span class="muted">Al termine potrai avviare questo.</span>
				}
			</span>
		</div>
	} else {
		<div id="review-bar" class="review-bar">
			<span class="review-msg">
				if st.For(d.SelChat, d.SelKey) && st.Message != "" {
					<span class={ templ.KV("review-error", st.Error) }>{ st.Message }</span>
				} else if d.Review != nil && d.Review.LastRun != "" {
					<span class="muted">Ultimo controllo: { d.Review.LastRun }</span>
				} else {
					<span class="muted">L'AI segnala le risposte dubbie o ambigue e propone l'ordine da aggiungere.</span>
				}
			</span>
			<button
				type="button"
				class="btn primary"
				hx-post="/inserzioni/review"
				hx-vals={ templ.JSONString(map[string]string{"chat": d.SelChat, "c": d.SelKey}) }
				hx-target="#review-bar"
				hx-swap="outerHTML"
			>
				if d.Review != nil && d.Review.LastRun != "" {
					Ricontrolla risposte
				} else {
					Controlla risposte
				}
				@IconSparkles()
			</button>
		</div>
	}
}

// ReviewFilter: all replies / only those to check. The choice is applied by
// app.js on [data-replies] and survives the out-of-band refreshes.
templ ReviewFilter(d InserzioniData, oob bool) {
	<div id="review-filter" class="review-filter" { oobAttrs(oob)... }>
		if n := openChecks(d.Replies); n > 0 || reviewed(d.Replies) {
			<div class="seg" role="group" aria-label="Mostra">
				<button type="button" class="seg-btn active" data-flag-view="all" aria-pressed="true">Tutte ({ itoa(len(d.Replies)) })</button>
				<button type="button" class="seg-btn" data-flag-view="open" aria-pressed="false">Da verificare ({ itoa(n) })</button>
			</div>
		}
	</div>
}

templ ReplyItem(d InserzioniData, r service.ReplyView, oob bool) {
	<div
		class={ "reply", templ.KV("flagged", r.Check.Open()), templ.KV("flag-ambigua", r.Check.Open() && r.Check.Kind == "ambigua") }
		data-name={ r.Utente }
		id={ "reply-" + i64(r.ID) }
		{ oobAttrs(oob)... }
	>
		<div class="reply-head">
			if r.Ordine {
				<span class="reply-ok" title="Letto come ordine" aria-label="Letto come ordine">@IconCheck()</span>
			}
			<b class="reply-name">{ r.Utente }</b>
			if r.Reading != "" {
				<span class="reply-reading">{ r.Reading }</span>
			}
			<span class="muted reply-time">{ r.Ora }</span>
			if r.Manual {
				<span class="badge badge-info">Aggiunta a mano</span>
			}
			<button
				class="icon danger"
				title="Elimina messaggio"
				aria-label="Elimina messaggio"
				hx-delete={ "/replies/" + i64(r.ID) }
				hx-target={ "#reply-" + i64(r.ID) }
				hx-swap="outerHTML"
				hx-confirm="Eliminare questo messaggio?"
			>@IconX()</button>
		</div>
		<div class="reply-text">{ compactText(r.Testo) }</div>
		if r.Override != "" {
			<form class="reply-fixed" hx-post={ "/replies/" + i64(r.ID) + "/order" } hx-swap="none">
				<input type="hidden" name="chat" value={ d.SelChat }/>
				<input type="hidden" name="c" value={ d.SelKey }/>
				<span class="badge badge-ok">Corretta a mano</span>
				<span>{ overrideLabel(r.Override) }</span>
				<button type="submit" class="btn small" name="op" value="reset">Annulla correzione</button>
			</form>
		} else if r.Check.Open() && d.Review != nil {
			@ReviewPanel(d, r)
		} else if !r.Ordine && d.Review != nil && d.Review.Orderable && !d.Review.SellerIDs[r.AuthorID] {
			<div class="reply-actions">
				<button
					type="button"
					class="btn small"
					hx-get={ "/replies/" + i64(r.ID) + "/order?" + reviewVals(d) }
					hx-target="#modal"
					hx-swap="innerHTML"
				>Conferma come ordine</button>
			</div>
		}
	</div>
}

// ReviewPanel: why the reply was flagged and the proposed order, editable.
templ ReviewPanel(d InserzioniData, r service.ReplyView) {
	<form class="review-panel" hx-post={ "/replies/" + i64(r.ID) + "/order" } hx-swap="none">
		<input type="hidden" name="chat" value={ d.SelChat }/>
		<input type="hidden" name="c" value={ d.SelKey }/>
		<div class="review-why">
			<span class={ "badge", templ.KV("badge-warn", r.Check.Kind != "ambigua"), templ.KV("badge-info", r.Check.Kind == "ambigua") }>{ kindLabel(r.Check.Kind) }</span>
			if r.Check.Reason != "" {
				<span>{ r.Check.Reason }</span>
			}
		</div>
		<p class="review-facts muted">
			Letto ora:
			if r.Reading != "" {
				<b>{ r.Reading }</b>
			} else {
				nessun ordine
			}
			if cur := d.Review.Current[r.AuthorID]; cur != "" && cur != r.Reading {
				· ordine attuale di { r.Utente }: <b>{ cur }</b>
			}
			if r.Check.Stale {
				· il messaggio è cambiato dopo il controllo
			}
		</p>
		if len(d.Review.Options) == 0 {
			@Alert("info", "Questa inserzione non ha opzioni con lettera (A, B…): non c'è un ordine a cui aggiungere la risposta.")
			<div class="review-actions">
				<button type="submit" class="btn" name="op" value="dismiss">Ignora</button>
			</div>
		} else {
			<fieldset class="add-panel proposal" data-proposal>
				<legend>
					if r.Check.Proposal != "" {
						Ordine proposto
					} else {
						Indica l'ordine
					}
					if d.Review.QuotationNumber != "" {
						· { d.Review.QuotationNumber }
					}
				</legend>
				{{ qty := proposalQty(d.Review, r) }}
				{{ shown, more := proposalRows(d.Review, qty) }}
				<div class="prop-rows">
					for _, o := range shown {
						@proposalRow("q", r, o, qty)
					}
				</div>
				if len(more) > 0 {
					<details class="prop-more">
						<summary>Altre opzioni ({ itoa(len(more)) })</summary>
						<div class="prop-rows">
							for _, o := range more {
								@proposalRow("q", r, o, qty)
							}
						</div>
					</details>
				}
				<div class="prop-foot">
					<span class="muted">Vuoto = opzione non toccata · 0 = annullata</span>
					<b class="prop-total" data-prop-total></b>
				</div>
			</fieldset>
			<div class="review-actions">
				<button type="submit" class="btn primary" name="op" value="apply">Aggiungi all'ordine</button>
				<button type="submit" class="btn" name="op" value="notorder">Non è un ordine</button>
				<button type="submit" class="btn" name="op" value="dismiss" title="La lettura automatica va bene così">Ignora</button>
			</div>
		}
	</form>
}

// proposalRow: one option with its quantity stepper; prefix keeps the ids
// of the inline panel ("q") and of the modal ("m") apart.
templ proposalRow(prefix string, r service.ReplyView, o service.OrderOption, qty map[string]int) {
	<div class="prop-row">
		<label class="prop-opt" for={ prefix + "-" + i64(r.ID) + "-" + o.Key }>
			<b>{ o.Label() }</b>
		</label>
		<span class="prop-wine">
			{ noEmoji(o.Wine) }
			<span class="muted nowrap">€ { money(o.Price) }</span>
		</span>
		<span class="stepper">
			<button type="button" class="btn step" data-step="-1" aria-label={ "Meno " + o.Label() }>&minus;</button>
			<input
				type="number"
				id={ prefix + "-" + i64(r.ID) + "-" + o.Key }
				name={ "qty_" + o.Key }
				value={ qtyValue(qty, o.Key) }
				min="0"
				max="999"
				step="1"
				inputmode="numeric"
				placeholder="–"
				data-price={ money(o.Price) }
				aria-label={ "Quantità " + o.Label() }
			/>
			<button type="button" class="btn step" data-step="1" aria-label={ "Più " + o.Label() }>+</button>
		</span>
	</div>
}

// ModalSlot holds the open modal; emptied out-of-band once it is done.
templ ModalSlot(oob bool) {
	<div id="modal" { oobAttrs(oob)... }></div>
}

// ReplyOrderModal: confirm by hand a reply the rules didn't read as an
// order. The lines go to the order (quotation) of the inserzione, next to
// those read automatically.
templ ReplyOrderModal(d InserzioniData, r service.ReplyView, qty map[string]int, errMsg string) {
	<dialog class="modal" data-modal-open aria-labelledby={ "modal-title-" + i64(r.ID) }>
		<form class="modal-form" hx-post={ "/replies/" + i64(r.ID) + "/order" } hx-swap="none">
			<input type="hidden" name="chat" value={ d.SelChat }/>
			<input type="hidden" name="c" value={ d.SelKey }/>
			<input type="hidden" name="modal" value="1"/>
			<div class="modal-head">
				<div class="modal-title">
					<h3 id={ "modal-title-" + i64(r.ID) }>Conferma ordine</h3>
					<span class="muted">
						{ r.Utente } · { r.Ora }
						if d.Review != nil && d.Review.QuotationNumber != "" {
							· ordine { d.Review.QuotationNumber }
						}
					</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()</button>
			</div>
			<div class="modal-body">
				<div class="modal-quote">{ compactText(r.Testo) }</div>
				@OrderMismatch(d.Review)
				if errMsg != "" {
					@Alert("error", errMsg)
				}
				if d.Review == nil || len(d.Review.Options) == 0 {
					@Alert("info", "Questa inserzione non ha vini con prezzo da cui creare l'ordine.")
				} else {
					if cur := d.Review.Current[r.AuthorID]; cur != "" {
						<p class="muted modal-note">Ordine attuale di { r.Utente }: <b>{ cur }</b>. Le quantità indicate qui sostituiscono quelle della stessa opzione.</p>
					}
					<fieldset class="add-panel proposal" data-proposal>
						<legend>Vino e quantità</legend>
						<div class="prop-rows">
							for _, o := range d.Review.Options {
								@proposalRow("m", r, o, qty)
							}
						</div>
						<div class="prop-foot">
							<span class="muted">Vuoto = opzione non toccata · 0 = annullata</span>
							<b class="prop-total" data-prop-total></b>
						</div>
					</fieldset>
				}
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
				if d.Review != nil && len(d.Review.Options) > 0 {
					<button type="submit" class="btn primary" name="op" value="apply">Conferma ordine</button>
				}
			</div>
		</form>
	</dialog>
}
