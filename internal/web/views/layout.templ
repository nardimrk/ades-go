package views

type NavItem struct {
	Key   string
	Label string
	Href  string
}

var nav = []NavItem{
	{"inserzioni", "Inserzioni", "/inserzioni"},
	{"ordini", "Ordini", "/ordini"},
	{"consegne", "Consegne", "/consegne"},
	{"clienti", "Clienti", "/clienti"},
	{"prodotti", "Prodotti", "/prodotti"},
	{"statistiche", "Statistiche", "/statistiche"},
	{"importa", "Importa Chat", "/importa"},
	{"whatsapp", "WhatsApp", "/whatsapp"},
}

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="it">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content="#8b1e3f" media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content="#111318" media="(prefers-color-scheme: dark)"/>
			<!-- added to the home screen, the app opens full screen (no browser bar),
			     so the floating button can sit in the screen's rounded corner -->
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<meta name="apple-mobile-web-app-title" content="ADE'S Wine Club"/>
			<title>{ title } · ADE'S Wine Club</title>
			<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%227%22 fill=%22%238b1e3f%22/><text x=%2216%22 y=%2222.5%22 font-family=%22system-ui,sans-serif%22 font-size=%2218%22 font-weight=%22700%22 fill=%22white%22 text-anchor=%22middle%22>A</text></svg>"/>
			<script>
				// Apply the theme before the first paint (no light flash in dark mode).
				try {
					var t = localStorage.getItem("adesgo-theme");
					if (!t) { t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; }
					document.documentElement.dataset.theme = t;
				} catch (e) {}
			</script>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body hx-boost="true">
			{ children... }
			<div id="toasts" aria-live="polite"></div>
		</body>
	</html>
}

templ Layout(title, active string) {
	@Base(title) {
		<div class="shell">
			<aside class="sidebar">
				<div class="brand">ADE'S Wine Club</div>
				<div class="nav-wrap" data-nav-wrap>
					<nav>
						for _, n := range nav {
							<a href={ templ.URL(n.Href) } class={ templ.KV("active", n.Key == active) }>{ n.Label }</a>
						}
					</nav>
					// arrows of the horizontally scrolling mobile menu, shown only
					// on the side where more sections are hidden
					<button type="button" class="nav-arrow left" data-nav-scroll="-1" tabindex="-1" aria-label="Sezioni precedenti">@IconChevronLeft()</button>
					<button type="button" class="nav-arrow right" data-nav-scroll="1" tabindex="-1" aria-label="Altre sezioni">@IconChevronRight()</button>
				</div>
				<div class="sidebar-foot">
					<form method="post" action="/logout" class="logout">
						<button type="submit" class="link">Esci</button>
					</form>
					@NotifBell()
					<button type="button" class="theme-toggle" data-theme-toggle title="Tema chiaro / scuro" aria-label="Cambia tema chiaro / scuro">
						<span class="sun">@IconSun()</span>
						<span class="moon">@IconMoon()</span>
					</button>
				</div>
			</aside>
			<main class="content">
				{ children... }
			</main>
		</div>
		@SectionFab(active)
	}
}

// fabNav: the sections offered by the floating button.
var fabNav = nav[:3] // Inserzioni, Ordini, Consegne

templ fabIcon(key string) {
	switch key {
		case "inserzioni":
			@IconMegaphone()
		case "ordini":
			@IconReceipt()
		case "consegne":
			@IconTruck()
	}
}

// SectionFab: a floating button (bottom right, on every screen size) that
// fans out the main sections over a dimmed backdrop.
templ SectionFab(active string) {
	<div class="fab" data-fab>
		<div class="fab-backdrop" data-fab-close></div>
		<nav class="fab-menu" id="fab-menu" aria-label="Vai a una sezione">
			for _, n := range fabNav {
				<a
					href={ templ.URL(n.Href) }
					class={ "fab-item", templ.KV("active", n.Key == active) }
					aria-label={ n.Label }
					if n.Key == active {
						aria-current="page"
					}
				>
					@fabIcon(n.Key)
					<span class="fab-label" aria-hidden="true">{ n.Label }</span>
				</a>
			}
		</nav>
		<button type="button" class="fab-btn" data-fab-toggle aria-expanded="false" aria-controls="fab-menu" aria-label="Sezioni">
			<span class="fab-open">@IconGrid()</span>
			<span class="fab-close">@IconX()</span>
		</button>
	</div>
}

// Toast is returned out-of-band by htmx handlers to show a notification.
templ Toast(kind, msg string) {
	<div id="toasts" hx-swap-oob="beforeend">
		<div class={ "toast", "toast-" + kind } data-autohide>{ msg }</div>
	</div>
}

templ Alert(kind, msg string) {
	<div class={ "alert", "alert-" + kind }>{ msg }</div>
}
