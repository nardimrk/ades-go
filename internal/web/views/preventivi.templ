package views

import (
	"adesgo/internal/service"
	"crypto/sha1"
	"encoding/hex"
	"strings"
)

func sectionID(utente string) string {
	h := sha1.Sum([]byte(utente))
	return "sec-" + hex.EncodeToString(h[:5])
}

func previewURL(num string) string { return "/ordini/view?" + q("n", num) }

// PreventiviPage is the Ordini page (quotations, called "ordini" in the UI).
templ PreventiviPage(search, flash string, list templ.Component) {
	@Layout("Ordini", "ordini") {
		if flash != "" {
			<div id="toasts-init" hidden data-toast={ flash }></div>
		}
		<div class="row between">
			<h2>Ordini</h2>
			<div class="row">
				<a href="/ordini/nuovo" class="btn primary">+ Crea</a>
				<button class="btn" hx-post="/ordini/import" hx-target="#prev-list">Importa</button>
			</div>
		</div>
		<input
			type="search"
			name="q"
			value={ search }
			placeholder="Filtra Ordini…"
			class="list-filter"
			hx-get="/ordini/list"
			hx-trigger="input changed delay:300ms, search"
			hx-target="#prev-list"
		/>
		<div id="prev-list">
			@list
		</div>
	}
}

// PreventiviSummary: the orders as a monthly timeline (newest first, by order
// date). It refreshes itself every 30s to pick up new WhatsApp replies;
// hx-disinherit keeps the links inside from inheriting the refresh target
// (otherwise a click would load the whole page inside the list).
templ PreventiviSummary(months []service.QuotationMonth) {
	<div hx-get="/ordini/list" hx-trigger="every 30s" hx-target="#prev-list" hx-include="[name=q]" hx-disinherit="*">
		if len(months) == 0 {
			@Alert("info", "Nessun ordine presente. Usa \"+ Crea\" o \"Importa\" per crearne uno.")
		} else {
			<div class="view-timeline timeline">
				for _, m := range months {
					<section class="month">
						<header class="month-head">
							<h3>{ monthLabel(m.Year, m.Month) }</h3>
							<span class="muted">
								{ plural(len(m.Rows), "ordine", "ordini") } · { itoa(m.Bottiglie) } bott. · € { money(m.Totale) }
							</span>
						</header>
						<div class="month-items">
							for _, r := range m.Rows {
								<a class={ "dl-item", "dl-link", templ.KV("dl-empty", r.Clienti == 0) } href={ templ.URL(previewURL(r.Number)) }>
									<span class="dl-day">{ dayMonthShort(r.Date) }</span>
									<span class="dl-main">
										if r.Manual {
											<b class="dl-title dl-manual" title="Ordine manuale">
												@IconHand()
												<span class="sr-only">Ordine manuale</span>
												{ noEmoji(r.Title) }
											</b>
										} else {
											<b class="dl-title">{ noEmoji(r.Title) }</b>
										}
										<span class="muted dl-group">{ r.Number }</span>
									</span>
									<span class="dl-stats">
										if r.Clienti == 0 {
											<span>nessuna selezione</span>
										} else {
											<span>{ plural(r.Clienti, "cliente", "clienti") }</span>
											<span>{ itoa(r.Bottiglie) } bott.</span>
											<b>€ { money(r.Totale) }</b>
										}
										if r.SavedOn != "" {
											<span class="badge badge-ok">Confermato il { r.SavedOn }</span>
										}
									</span>
								</a>
							}
						</div>
					</section>
				}
			</div>
		}
	</div>
}

templ PreventiviSearch(rows []service.Selection) {
	if len(rows) == 0 {
		@Alert("info", "Nessun risultato.")
	} else {
		<table class="table clickable">
			<thead>
				<tr><th>Utente</th><th>Vino</th><th class="num">Qta</th><th class="num">Prezzo (€)</th><th>Ordine</th><th>Data</th></tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr data-href={ previewURL(r.Preventivo) }>
						<td class="title-cell">{ r.Utente }</td>
						<td>{ noEmoji(r.Vino) }</td>
						<td class="num">{ itoa(r.Qta) }</td>
						<td class="num">{ money(r.Prezzo) }</td>
						<td><a href={ templ.URL(previewURL(r.Preventivo)) }>{ r.Preventivo }</a></td>
						<td>{ r.DataPrev }</td>
					</tr>
				}
			</tbody>
		</table>
		<p class="muted">Clicca su una riga per aprire l'ordine.</p>
	}
}

templ PreventivoDetail(d *service.QuotationDetail, catalog []service.CatalogEntry) {
	@Layout("Ordine "+d.Quotation.Number, "ordini") {
		<div class="page-head">
			<a href="/ordini" class="btn icon-btn" title="Elenco" aria-label="Elenco">@IconList()</a>
			<h2>{ d.Quotation.Number } · { d.Date }</h2>
			<div class="head-actions">
				// the listing the order comes from (manual orders have none)
				if d.ListingURL != "" {
					<a
						href={ templ.URL(d.ListingURL) }
						class="btn icon-btn order-link"
						title={ "Apri l'inserzione: " + d.ListingTitle }
						aria-label={ "Apri l'inserzione: " + d.ListingTitle }
					>@IconMegaphone()</a>
				}
				<nav class="prev-next" aria-label="Altri ordini">
					@orderNeighborLink(d.Prev, "Ordine precedente", true)
					@orderNeighborLink(d.Next, "Ordine successivo", false)
				</nav>
			</div>
		</div>
		<hr/>
		if len(d.Sections) == 0 {
			@Alert("info", "Nessun cliente ha ancora selezionato vini per questo ordine.")
		}
		@ProdottiDatalist(catalog)
		@ClientiDatalist(d.Sections)
		@ModalSlot(false)
		@StockSummary(d.Stock)
		if len(d.Sections) > 1 {
			<div class="filters sections-filter">
				<input type="search" placeholder="Filtra per cliente, città o provincia" data-filter=".cust-section" aria-label="Filtra per cliente, città o provincia"/>
				<span class="muted" data-filter-count=".cust-section" data-noun="clienti">{ itoa(len(d.Sections)) } clienti</span>
			</div>
		}
		for _, sec := range d.Sections {
			@CustomerSection(d.Quotation.Number, sec, "", "", "")
		}
	}
}

// ProdottiDatalist: the Prodotti suggested (and filtered as you type) by the
// "add a wine" fields of every customer section on the page.
templ ProdottiDatalist(catalog []service.CatalogEntry) {
	<datalist id="prodotti-list">
		for _, e := range catalog {
			if e.Winery != "" {
				<option value={ e.Description }>{ e.Winery }</option>
			} else {
				<option value={ e.Description }></option>
			}
		}
	</datalist>
}

// itemDelivery: a manual wine's estimated delivery. Connected to a
// listing's option, it shows that listing's date and a link to it;
// otherwise its own date, and "Collega" to connect it.
templ itemDelivery(qid int64, r service.OrderRow, d service.ItemDelivery) {
	<div class="item-delivery">
		if d.Linked {
			<span class="item-date">
				if d.Date != "" {
					{ dateIT(d.Date) }
				} else {
					<span class="muted">data non indicata</span>
				}
			</span>
			<a href={ templ.URL(d.LinkedURL) } class="link-pill" title={ "Collegato a: " + d.LinkedTitle + " · opzione " + d.LinkedOption }>
				@IconMegaphone()
				<span>{ d.LinkedOption }</span>
			</a>
			<button
				type="button"
				class="icon"
				title="Scollega dall'inserzione"
				aria-label="Scollega dall'inserzione"
				hx-post="/ordini/link"
				hx-vals={ templ.JSONString(map[string]string{"q": i64(qid), "option": r.Opzione, "to_q": "0"}) }
				hx-swap="none"
				hx-confirm={ "Scollegare " + r.Vino + " dall'inserzione? Tornerà ad avere la sua data di consegna." }
			>@IconX()</button>
		} else {
			<input
				type="date"
				name="value"
				value={ d.Date }
				aria-label={ "Consegna stimata " + r.Vino }
				data-autosave
				hx-post="/ordini/consegna"
				hx-trigger="change"
				hx-swap="none"
				hx-vals={ templ.JSONString(map[string]string{"q": i64(qid), "option": r.Opzione}) }
			/>
			<button
				type="button"
				class="btn small"
				title="Collega a un vino di un'inserzione"
				hx-get={ "/ordini/link?" + q("q", i64(qid), "option", r.Opzione, "vino", r.Vino) }
				hx-target="#modal"
				hx-swap="innerHTML"
			>Collega</button>
		}
	</div>
}

// LinkModal: the listings with their wine options, to connect a manual wine.
templ LinkModal(qid int64, option, wine string, camps []service.LinkCampaign) {
	<dialog class="modal modal-move" data-modal-open aria-labelledby="link-title">
		<div class="modal-form">
			<div class="modal-head">
				<div class="modal-title">
					<h3 id="link-title">Collega a un'inserzione</h3>
					<span class="muted">{ wine }: prende la data di consegna dell'inserzione e conta nella sua disponibilità</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()</button>
			</div>
			<div class="modal-body">
				<input type="search" placeholder="Cerca un'inserzione o un vino…" data-filter=".link-camp" aria-label="Cerca un'inserzione o un vino"/>
				<div class="move-list">
					for _, c := range camps {
						<div class="link-camp" data-name={ linkCampName(c) }>
							<div class="link-camp-head">
								<span class="dl-day">{ dayMonthShort(c.Published) }</span>
								<b>{ c.Title }</b>
							</div>
							for _, o := range c.Options {
								<button
									type="button"
									class="move-item link-opt"
									hx-post="/ordini/link"
									hx-vals={ templ.JSONString(map[string]string{"q": i64(qid), "option": option, "to_q": i64(o.QuotationID), "to_opt": o.Letter}) }
									hx-swap="none"
								>
									<b class="stock-opt">{ o.Letter }</b>
									<span>{ noEmoji(o.Wine) }</span>
								</button>
							}
						</div>
					}
				</div>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
			</div>
		</div>
	</dialog>
}

func linkCampName(c service.LinkCampaign) string {
	n := c.Title + " " + c.ChatName
	for _, o := range c.Options {
		n += " " + o.Wine
	}
	return n
}

// orderNeighborLink: the order before/after this one in the Ordini list.
templ orderNeighborLink(q *service.QuotationSummary, label string, left bool) {
	if q != nil {
		<a href={ templ.URL(previewURL(q.Number)) } class="btn icon-btn" title={ label + ": " + q.Number + " · " + q.Title } aria-label={ label }>
			if left {
				@IconChevronLeft()
			} else {
				@IconChevronRight()
			}
		</a>
	} else {
		<button type="button" class="btn icon-btn" disabled aria-label={ label }>
			if left {
				@IconChevronLeft()
			} else {
				@IconChevronRight()
			}
		</button>
	}
}

// stockOver reports an option ordered beyond its availability.
func stockOver(stock []service.OptionStock) bool {
	for _, o := range stock {
		if o.Excess() > 0 {
			return true
		}
	}
	return false
}

// StockSummary: for each wine option, the bottles ordered and how many are
// still available (red when ordered beyond availability).
templ StockSummary(stock []service.OptionStock) {
	if len(stock) > 0 {
		<section class={ "stock-summary", templ.KV("stock-over", stockOver(stock)) } aria-label="Ordinato e disponibile">
			if stockOver(stock) {
				<b class="stock-alert">Attenzione: alcune opzioni sono state ordinate oltre la disponibilità.</b>
			}
			<ul>
				for _, o := range stock {
					<li class={ templ.KV("over", o.Excess() > 0) }>
						<span class="stock-opt">{ o.Letter }</span>
						<span class="stock-wine">{ noEmoji(o.Wine) }</span>
						<span class="stock-nums">
							<span>ordinate <b>{ itoa(o.Ordered) }</b></span>
							if o.HasCount {
								<span>disponibili <b>{ itoa(o.Offered) }</b></span>
								if o.Excess() > 0 {
									<span>restano <b>0</b> · <b>{ itoa(o.Excess()) } in più</b></span>
								} else {
									<span>restano <b>{ itoa(o.Remaining()) }</b></span>
								}
							} else {
								<span class="muted">disponibilità non indicata</span>
							}
						</span>
					</li>
				}
			</ul>
		</section>
	}
}

// ClientiDatalist: the customers offered by "Modifica cliente" in every
// section of the page.
templ ClientiDatalist(sections []service.CustomerSection) {
	<datalist id="clienti-list">
		for _, c := range clientChoices(sections) {
			<option value={ c }></option>
		}
	</datalist>
}

// CustomerSection: one customer's order. clientErr reopens the "Modifica
// cliente" modal with that error.
templ CustomerSection(qnum string, sec service.CustomerSection, msg, errMsg, clientErr string) {
	<form
		id={ sectionID(sec.Utente) }
		class="card cust-section"
		data-name={ sec.Cliente + " " + sec.Utente + " " + sec.Citta + " " + sec.Provincia }
		hx-post="/ordini/section"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="n" value={ qnum }/>
		<input type="hidden" name="utente" value={ sec.Utente }/>
		<input type="hidden" name="cliente" value={ sec.Cliente }/>
		<div class="card-head">
			<span class="client-row">
				<b class="client-name">{ sec.Cliente }</b>
				if p := sec.Place(); p != "" {
					<span class="muted client-place">{ p }</span>
				}
				<button type="button" class="btn small" data-modal-show={ sectionID(sec.Utente) + "-cliente" }>Cambia</button>
				<span class="nowrap">€ { money(sec.Total()) }</span>
			</span>
			if sec.SavedOn != "" {
				<span class="badge badge-ok">Confermato il { sec.SavedOn }</span>
			} else {
				<span class="section-actions">
					<button type="button" class="btn" data-modal-show={ sectionID(sec.Utente) + "-vino" }>＋ Aggiungi vino</button>
					<button type="submit" name="op" value="save" class="btn primary">Conferma ordine</button>
				</span>
			}
		</div>
		if msg != "" {
			@Alert("success", msg)
		}
		if sec.Cliente != sec.Utente {
			<p class="muted">Nome originale rilevato: { sec.Utente }</p>
		}
		@clientModal(sec, clientErr)
		if len(sec.Rows) == 0 {
			<p class="muted">Nessuna riga.</p>
		} else {
			<table class="table">
				<thead>
					<tr><th>Vino</th><th class="num">Qtà</th><th class="num">Prezzo (€)</th><th class="num">Totale (€)</th>
						if sec.Manual {
							<th class="col-consegna">Consegna stimata</th>
						}
						if sec.SavedOn == "" {
							<th class="num"></th>
						}
					</tr>
				</thead>
				<tbody>
					for i, r := range sec.Rows {
						<tr>
							<td class="title-cell">
								{ noEmoji(r.Vino) }
								<input type="hidden" name="opz" value={ r.Opzione }/>
								<input type="hidden" name="vino" value={ r.Vino }/>
								<input type="hidden" name="qta" value={ itoa(r.Qta) }/>
								<input type="hidden" name="prezzo" value={ num(r.Prezzo) }/>
							</td>
							<td class="num">{ itoa(r.Qta) }</td>
							<td class="num">{ money(r.Prezzo) }</td>
							<td class="num">{ money(r.Totale()) }</td>
							if sec.Manual {
								<td class="col-consegna">
									if d, ok := sec.Consegne[strings.ToUpper(r.Opzione)]; ok && r.Opzione != "" {
										@itemDelivery(sec.QuotationID, r, d)
									} else {
										<span class="muted">–</span>
									}
								</td>
							}
							if sec.SavedOn == "" {
								<td class="num"><button type="submit" name="op" value={ "del:" + itoa(i) } class="icon danger" title="Rimuovi riga" aria-label="Rimuovi riga">@IconX()</button></td>
							}
						</tr>
					}
				</tbody>
			</table>
		}
		if sec.SavedOn == "" {
			@addWineModal(sec, errMsg)
		}
	</form>
}

// addWineModal adds a wine (from Prodotti) to the customer's order. Like
// clientModal it sits inside the section's form, so the draft rows travel
// with it; errMsg reopens it with the error.
templ addWineModal(sec service.CustomerSection, errMsg string) {
	<dialog
		id={ sectionID(sec.Utente) + "-vino" }
		class="modal modal-wine"
		data-modal-keep
		if errMsg != "" {
			data-modal-open
		}
		aria-labelledby={ sectionID(sec.Utente) + "-vino-title" }
	>
		<div class="modal-form">
			<div class="modal-head">
				<div class="modal-title">
					<h3 id={ sectionID(sec.Utente) + "-vino-title" }>Aggiungi un vino all'ordine</h3>
					<span class="muted">{ sec.Cliente }</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()</button>
			</div>
			<div class="modal-body">
				if errMsg != "" {
					@Alert("error", errMsg)
				}
				<label class="add-wine">
					Vino (dai Prodotti)
					<input type="text" name="new_vino" list="prodotti-list" placeholder="Scrivi per cercare tra i Prodotti…" autocomplete="off"/>
				</label>
				<div class="add-wine-nums">
					<label>
						Quantità
						<input type="number" name="new_qta" min="1" step="1" value="1"/>
					</label>
					<label>
						Prezzo (€)
						<input type="number" name="new_prezzo" min="0" step="0.01" placeholder="0,00"/>
					</label>
				</div>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
				<button type="submit" name="op" value="add" class="btn primary">＋ Aggiungi</button>
			</div>
		</div>
	</dialog>
}

// clientModal changes the section's customer. It sits inside the section's
// form, so the draft rows travel with the change.
templ clientModal(sec service.CustomerSection, errMsg string) {
	<dialog
		id={ sectionID(sec.Utente) + "-cliente" }
		class="modal modal-client"
		data-modal-keep
		if errMsg != "" {
			data-modal-open
		}
		aria-labelledby={ sectionID(sec.Utente) + "-cliente-title" }
	>
		<div class="modal-form">
			<div class="modal-head">
				<div class="modal-title">
					<h3 id={ sectionID(sec.Utente) + "-cliente-title" }>Modifica cliente</h3>
					<span class="muted">Attuale: { sec.Cliente }</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()</button>
			</div>
			<div class="modal-body">
				if errMsg != "" {
					@Alert("error", errMsg)
				}
				<label>
					Nuovo cliente
					<input type="text" name="new_cliente" list="clienti-list" placeholder="Scrivi per cercare un cliente..." autocomplete="off"/>
				</label>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
				<button type="submit" class="btn primary" name="op" value="cliente">Salva</button>
			</div>
		</div>
	</dialog>
}

type NuovoPreventivoData struct {
	Number   string
	Date     string
	Clients  []string
	Cliente  string
	Catalog  []service.CatalogEntry
	Rows     []service.NewQuotationRow
	Error    string
}

templ NuovoPreventivo(d NuovoPreventivoData) {
	@Layout("Nuovo ordine", "ordini") {
		<div class="page-head">
			<a href="/ordini" class="btn">← Elenco</a>
			<h2>Nuovo ordine</h2>
		</div>
		if d.Error != "" {
			@Alert("error", d.Error)
		}
		<form method="post" action="/ordini/nuovo" class="stack" id="np-form">
			<div class="np-head">
				<div class="np-number"><b>Numero ordine:</b> <code>{ d.Number }</code></div>
				<label>
					Cliente
					<input type="text" name="cliente" list="np-clients" value={ d.Cliente } placeholder="Scrivi per cercare un cliente..." autocomplete="off" required/>
				</label>
				<label>Data <input type="date" name="date" value={ d.Date } required/></label>
			</div>
			<datalist id="np-clients">
				for _, c := range d.Clients {
					<option value={ c }></option>
				}
			</datalist>
			<hr/>
			<h3>Prodotti</h3>
			<datalist id="catalog">
				for _, e := range d.Catalog {
					<option value={ e.Label() }></option>
				}
			</datalist>
			<table class="table" id="np-rows">
				<thead><tr><th>N.</th><th>Vino</th><th>Quantità</th><th>Prezzo €</th></tr></thead>
				<tbody>
					for i, r := range d.Rows {
						<tr>
							<td><b>{ itoa(i + 1) }</b></td>
							<td><input type="text" name="vino" list="catalog" value={ r.WineName } placeholder="Scegli o scrivi un nuovo vino..."/></td>
							<td><input type="number" name="qta" min="1" step="1" value={ itoa(r.Quantity) }/></td>
							<td><input type="number" name="prezzo" min="0" step="0.5" value={ money(r.Price) }/></td>
						</tr>
					}
					<template>
						<tr>
							<td><b>__N__</b></td>
							<td><input type="text" name="vino" list="catalog" placeholder="Scegli o scrivi un nuovo vino..."/></td>
							<td><input type="number" name="qta" min="1" step="1" value="1"/></td>
							<td><input type="number" name="prezzo" min="0" step="0.5" value="0.00"/></td>
						</tr>
					</template>
				</tbody>
			</table>
			<div class="row between">
				<button type="button" class="btn" data-add-row="#np-rows" data-max="10">＋ Aggiungi</button>
				<button type="submit" class="btn primary">Crea</button>
			</div>
			<p class="muted">Sono salvate le righe con un vino e un prezzo maggiore di zero. I vini nuovi vengono aggiunti ai Prodotti.</p>
		</form>
	}
}
