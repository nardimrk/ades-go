package views

import (
	"adesgo/internal/service"
	"adesgo/internal/textutil"
	"time"
	"crypto/sha1"
	"encoding/hex"
	"strings"
)

func sectionID(utente string) string {
	h := sha1.Sum([]byte(utente))
	return "sec-" + hex.EncodeToString(h[:5])
}

func previewURL(num string) string { return "/ordini/view?" + q("n", num) }

// PreventiviPage is the Ordini page (quotations, called "ordini" in the UI).
templ PreventiviPage(search, flash string, list templ.Component) {
	@Layout("Ordini", "ordini") {
		if flash != "" {
			<div id="toasts-init" hidden data-toast={ flash }></div>
		}
		<div class="row between">
			<h2>Ordini</h2>
			<div class="row">
				<a href="/ordini/nuovo" class="btn primary">+ Crea</a>
				<button class="btn" hx-post="/ordini/import" hx-target="#prev-list">Importa</button>
			</div>
		</div>
		<input
			type="search"
			name="q"
			value={ search }
			placeholder="Filtra Ordini…"
			class="list-filter"
			hx-get="/ordini/list"
			hx-trigger="input changed delay:300ms, search"
			hx-target="#prev-list"
		/>
		<div id="prev-list">
			@list
		</div>
	}
}

// PreventiviSummary: the orders as a monthly timeline (newest first, by order
// date). It refreshes itself every 30s to pick up new WhatsApp replies;
// PreventiviSummary: the orders of the last 6 months as a monthly timeline,
// refreshed every 30s; older orders in one closed section per year, their
// months loaded when opened (and left alone by the refresh).
templ PreventiviSummary(months []service.QuotationMonth) {
	if len(months) == 0 {
		@Alert("info", "Nessun ordine presente. Usa \"+ Crea\" o \"Importa\" per crearne uno.")
	} else {
		{{ recent, years := service.SplitRecentOrders(months, time.Now()) }}
		<div class="view-timeline timeline">
			@PreventiviRecent(recent)
			for _, y := range years {
				<details
					class="year-group"
					hx-get={ "/ordini/anno?" + q("y", itoa(y.Year)) }
					hx-trigger="toggle once"
					hx-target="find .year-body"
					hx-swap="innerHTML"
					hx-disinherit="*"
				>
					<summary class="year-head">
						<h3>
							if y.Year > 0 {
								{ itoa(y.Year) }
							} else {
								Senza data
							}
						</h3>
						<span class="muted">{ plural(y.Count, "ordine", "ordini") } · { itoa(y.Bottiglie) } bott. · € { money(y.Totale) }</span>
					</summary>
					<div class="year-body"><p class="muted">Caricamento…</p></div>
				</details>
			}
		</div>
	}
}

// PreventiviRecent: the months kept open, refreshed every 30s on their own
// (hx-disinherit keeps the links inside from inheriting the refresh swap).
templ PreventiviRecent(months []service.QuotationMonth) {
	<div id="prev-recent" hx-get="/ordini/recenti" hx-trigger="every 30s" hx-swap="outerHTML" hx-disinherit="*">
		for _, m := range months {
			@preventiviMonth(m)
		}
	</div>
}

// PreventiviYearMonths: the months of an older year, loaded when opened.
templ PreventiviYearMonths(months []service.QuotationMonth) {
	for _, m := range months {
		@preventiviMonth(m)
	}
	if len(months) == 0 {
		<p class="muted">Nessun ordine.</p>
	}
}

templ preventiviMonth(m service.QuotationMonth) {
	<section class="month">
		<header class="month-head">
			<h3>{ monthLabel(m.Year, m.Month) }</h3>
			<span class="muted">
				{ plural(len(m.Rows), "ordine", "ordini") } · { itoa(m.Bottiglie) } bott. · € { money(m.Totale) }
			</span>
		</header>
		<div class="month-items">
			for _, r := range m.Rows {
				<a class={ "dl-item", "dl-link", templ.KV("dl-empty", r.Clienti == 0) } href={ templ.URL(previewURL(r.Number)) }>
					<span class="dl-day">{ dayMonthShort(r.Date) }</span>
					<span class="dl-main">
						if r.Manual {
							<b class="dl-title dl-manual" title="Ordine manuale">
								@IconHand()
								<span class="sr-only">Ordine manuale</span>
								{ noEmoji(r.Title) }
							</b>
						} else {
							<b class="dl-title dl-manual" title="Ordine da un'inserzione WhatsApp">
								@IconRomanIOutline()
								<span class="sr-only">Ordine da un'inserzione WhatsApp</span>
								{ noEmoji(r.Title) }
							</b>
						}
						<span class="muted dl-group">{ r.Number }</span>
					</span>
					<span class="dl-stats">
						if r.Clienti == 0 {
							<span>nessuna selezione</span>
						} else {
							<span>{ plural(r.Clienti, "cliente", "clienti") }</span>
							<span>{ itoa(r.Bottiglie) } bott.</span>
							<b>€ { money(r.Totale) }</b>
						}
						if r.SavedOn != "" {
							<span class="badge badge-ok">Confermato il { r.SavedOn }</span>
						}
					</span>
				</a>
			}
		</div>
	</section>
}

templ PreventiviSearch(rows []service.Selection) {
	if len(rows) == 0 {
		@Alert("info", "Nessun risultato.")
	} else {
		@customerYearTotals(rows)
		<table class="table clickable">
			<thead>
				<tr><th>Utente</th><th>Vino</th><th class="num">Qta</th><th class="num">Prezzo (€)</th><th>Ordine</th><th>Data</th></tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr data-href={ previewURL(r.Preventivo) }>
						<td class="title-cell">{ r.Utente }</td>
						<td>{ noEmoji(r.Vino) }</td>
						<td class="num">{ itoa(r.Qta) }</td>
						<td class="num">{ money(r.Prezzo) }</td>
						<td><a href={ templ.URL(previewURL(r.Preventivo)) }>{ r.Preventivo }</a></td>
						<td>{ r.DataPrev }</td>
					</tr>
				}
			</tbody>
		</table>
		<p class="muted">Clicca su una riga per aprire l'ordine.</p>
	}
}

// customerYearTotals: when the filter leaves a single customer, what they
// ordered summed by year, plus the overall total.
templ customerYearTotals(rows []service.Selection) {
	if name, years, all := service.CustomerYearTotals(rows); name != "" {
		<section class="year-totals" aria-label={ "Totali per anno di " + name }>
			<h3>{ name } · totale per anno</h3>
			<div class="metrics">
				for _, y := range years {
					<div class="metric">
						<span>{ y.Year }</span>
						<b>€ { money(y.Totale) }</b>
						<span>{ plural(y.Ordini, "ordine", "ordini") } · { itoa(y.Bottiglie) } bott.</span>
					</div>
				}
				if len(years) > 1 {
					<div class="metric metric-total">
						<span>Totale</span>
						<b>€ { money(all.Totale) }</b>
						<span>{ plural(all.Ordini, "ordine", "ordini") } · { itoa(all.Bottiglie) } bott.</span>
					</div>
				}
			</div>
		</section>
	}
}

templ PreventivoDetail(d *service.QuotationDetail, catalog []service.CatalogEntry) {
	@Layout("Ordine "+d.Quotation.Number, "ordini") {
		<div class="page-head">
			<a href="/ordini" class="btn icon-btn" title="Elenco" aria-label="Elenco">@IconList()
</a>
			<h2>{ d.Quotation.Number } · { d.Date }</h2>
			<div class="head-actions">
				// the listing the order comes from (manual orders have none)
				if d.ListingURL != "" {
					<a
						href={ templ.URL(d.ListingURL) }
						class="btn icon-btn order-link"
						title={ "Apri l'inserzione: " + d.ListingTitle }
						aria-label={ "Apri l'inserzione: " + d.ListingTitle }
					>@IconRomanI()
</a>
					<button
						type="button"
						class="btn icon-btn order-link"
						title="Sposta l'ordine su un'altra inserzione"
						aria-label="Sposta l'ordine su un'altra inserzione"
						hx-get={ "/ordini/sposta?" + q("n", d.Quotation.Number) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>@IconMove()</button>
				}
				<nav class="prev-next" aria-label="Altri ordini">
					@orderNeighborLink(d.Prev, "Ordine precedente", true)
					@orderNeighborLink(d.Next, "Ordine successivo", false)
				</nav>
			</div>
		</div>
		<hr/>
		if len(d.Sections) == 0 && len(d.Linked) == 0 {
			@Alert("info", "Nessun cliente ha ancora selezionato vini per questo ordine.")
		}
		@ProdottiDatalist(catalog)
		@ClientiDatalist(d.Sections)
		@ModalSlot(false)
		@StockSummary(d.Quotation.Number, d.Stock)
		if n := len(d.Sections) + len(service.GroupLinked(d.Linked)); n > 1 {
			<div class="filters sections-filter">
				<input type="search" placeholder="Filtra per cliente, città o provincia" data-filter=".cust-section" aria-label="Filtra per cliente, città o provincia"/>
				<span class="muted" data-filter-count=".cust-section" data-noun="clienti">{ itoa(n) } clienti</span>
			</div>
		}
		for _, sec := range d.Sections {
			@CustomerSection(d.Quotation.Number, sec, "", "", "")
		}
		@LinkedManualOrders(d.Linked)
	}
}

// optTag: the listing option a row was ordered as, in front of the wine
// ("B", "A cassa" for a full-case option); nothing when it isn't known.
templ optTag(opz string) {
	if letter, isCase := strings.CutSuffix(strings.ToUpper(strings.TrimSpace(opz)), textutil.CaseSuffix); letter != "" {
		<span class="opt-tag" title={ "Opzione " + opz }>
			{ letter }
			if isCase {
				<span class="opt-case">cassa</span>
			}
		</span>
	}
}

// LinkedManualOrders: the manual orders with wines connected to this
// order's options (already counted in "ordinate"), one light blue card per
// order like the customers' cards; read-only, edited in their own order.
templ LinkedManualOrders(lines []service.LinkedLine) {
	for _, o := range service.GroupLinked(lines) {
		<section class="card cust-section manual-card" data-name={ o.Cliente + " " + o.Order }>
			<div class="card-head">
				<span class="client-row">
					<b class="client-name">{ o.Cliente }</b>
					<span class="nowrap">€ { money(o.Totale()) }</span>
				</span>
				<a href={ templ.URL(previewURL(o.Order)) } class="manual-badge" title="Si modifica nel suo ordine">
					@IconHand()
					<span>Ordine manuale { o.Order }</span>
				</a>
			</div>
			<table class="table">
				<thead>
					<tr>
						<th>Vino</th>
						<th class="num">Qtà</th>
						<th class="num">Prezzo (€)</th>
						<th class="num">Totale (€)</th>
						// empty, like the customers' delete column: the columns line up
						<th class="num"></th>
					</tr>
				</thead>
				<tbody>
					for _, l := range o.Lines {
						<tr>
							<td class="title-cell">
								<span class="wine-cell">
									@optTag(l.Opzione)
									{ noEmoji(l.Vino) }
								</span>
							</td>
							<td class="num">{ itoa(l.Qta) }</td>
							<td class="num">{ money(l.Prezzo) }</td>
							<td class="num">{ money(l.Totale()) }</td>
							<td class="num"></td>
						</tr>
					}
				</tbody>
			</table>
		</section>
	}
}

// ProdottiDatalist: the Prodotti suggested (and filtered as you type) by the
// "add a wine" fields of every customer section on the page.
templ ProdottiDatalist(catalog []service.CatalogEntry) {
	<datalist id="prodotti-list">
		for _, e := range catalog {
			if e.Winery != "" {
				<option value={ e.Description }>{ e.Winery }</option>
			} else {
				<option value={ e.Description }></option>
			}
		}
	</datalist>
}

// itemDate: a manual wine's estimated delivery: the date of the listing it
// is connected to, or its own date (editable).
templ itemDate(qid int64, r service.OrderRow, d service.ItemDelivery) {
	if d.Linked {
		<span class="item-date">
			if d.Date != "" {
				{ dateIT(d.Date) }
			} else {
				<span class="muted">data non indicata</span>
			}
		</span>
	} else {
		<input
			type="date"
			name="value"
			value={ d.Date }
			aria-label={ "Consegna stimata " + r.Vino }
			data-autosave
			hx-post="/ordini/consegna"
			hx-trigger="change"
			hx-swap="none"
			hx-vals={ templ.JSONString(map[string]string{"q": i64(qid), "option": r.Opzione}) }
		/>
	}
}

// itemLink: the listing a manual wine is connected to (pill + ✕ to
// disconnect), or "Collega" to connect it.
templ itemLink(qid int64, r service.OrderRow, d service.ItemDelivery) {
	if d.Linked {
		<span class="link-group">
			<a href={ templ.URL(d.LinkedURL) } class="link-pill" title={ "Apri l'inserzione: " + d.LinkedTitle + " · opzione " + d.LinkedOption }>
				@IconLink()
				if d.LinkedNumber != "" {
					<span>{ d.LinkedNumber } · { d.LinkedOption }</span>
				} else {
					<span>{ d.LinkedOption }</span>
				}
			</a>
			<button
				type="button"
				class="tool-pill pill-unlink"
				title="Scollega dall'inserzione"
				aria-label="Scollega dall'inserzione"
				hx-post="/ordini/link"
				hx-vals={ templ.JSONString(map[string]string{"q": i64(qid), "option": r.Opzione, "to_q": "0"}) }
				hx-swap="none"
				hx-confirm={ "Scollegare " + r.Vino + " dall'inserzione? Tornerà ad avere la sua data di consegna." }
			>@IconUnlink()</button>
		</span>
	} else {
		<button
			type="button"
			class="btn small"
			title="Collega a un vino di un'inserzione"
			hx-get={ "/ordini/link?" + q("q", i64(qid), "option", r.Opzione, "vino", r.Vino) }
			hx-target="#modal"
			hx-swap="innerHTML"
		>Collega</button>
	}
}

// LinkModal: the listings with their wine options, to connect a manual wine.
templ LinkModal(qid int64, option, wine string, camps []service.LinkCampaign) {
	<dialog class="modal modal-move" data-modal-open aria-labelledby="link-title">
		<div class="modal-form">
			<div class="modal-head">
				<div class="modal-title">
					<h3 id="link-title">Collega a un'inserzione</h3>
					<span class="muted">{ wine }: prende la data di consegna dell'inserzione e conta nella sua disponibilità. Inserzioni dai 6 mesi prima dell'ordine.</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()
</button>
			</div>
			<div class="modal-body">
				<input type="search" placeholder="Cerca un'inserzione o un vino…" data-filter=".link-camp" aria-label="Cerca un'inserzione o un vino"/>
				if len(camps) == 0 {
					@Alert("info", "Nessuna inserzione con un ordine nei 6 mesi prima di questo ordine.")
				}
				<div class="move-list">
					for _, c := range camps {
						<div class="link-camp" data-name={ linkCampName(c) }>
							<div class="link-camp-head">
								<span class="dl-day">{ dayMonthShort(c.Published) }</span>
								<b>{ c.Title }</b>
							</div>
							for _, o := range c.Options {
								<button
									type="button"
									class="move-item link-opt"
									hx-post="/ordini/link"
									hx-vals={ templ.JSONString(map[string]string{"q": i64(qid), "option": option, "to_q": i64(o.QuotationID), "to_opt": o.Letter}) }
									hx-swap="none"
								>
									<b class="stock-opt">{ o.Letter }</b>
									<span>{ noEmoji(o.Wine) }</span>
								</button>
							}
						</div>
					}
				</div>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
			</div>
		</div>
	</dialog>
}

func linkCampName(c service.LinkCampaign) string {
	n := c.Title + " " + c.ChatName
	for _, o := range c.Options {
		n += " " + o.Wine
	}
	return n
}

// NewCustomerModal: creates a customer without leaving the page; opened
// from a customer field's suggestions ("+ Nuovo cliente") with the typed name.
templ NewCustomerModal(id string) {
	<dialog id={ id } class="modal modal-address" data-modal-keep aria-labelledby={ id + "-title" }>
		<form class="modal-form" hx-post="/clienti/create" hx-swap="none">
			<div class="modal-head">
				<div class="modal-title">
					<h3 id={ id + "-title" }>Nuovo cliente</h3>
					<span class="muted">Solo il nome è obbligatorio; il resto si può completare in Clienti.</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()</button>
			</div>
			<div class="modal-body address-fields">
				<label class="span2">Nome <input type="text" name="name" required autocomplete="off"/></label>
				<label class="span2">Telefono <input type="tel" name="telefono" autocomplete="off" placeholder="+39…"/></label>
				<label class="span2">Indirizzo <input type="text" name="indirizzo" autocomplete="off"/></label>
				<label>Città <input type="text" name="citta" autocomplete="off"/></label>
				<label>Provincia <input type="text" name="provincia" autocomplete="off" list="province-list"/></label>
				@PlaceDatalists()
				<label>CAP <input type="text" name="cap" autocomplete="off" inputmode="numeric"/></label>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
				<button type="submit" class="btn primary">Crea cliente</button>
			</div>
		</form>
	</dialog>
}

// MoveOrderModal: the inserzioni to move the order to (most recent first,
// searchable); the ones with another order can't be picked.
templ MoveOrderModal(num, current string, rows []service.CampaignRow, quotNum map[int64]string) {
	<dialog class="modal modal-move" data-modal-open aria-labelledby="move-order-title">
		<form class="modal-form" hx-post="/ordini/sposta" hx-swap="none">
			<input type="hidden" name="n" value={ num }/>
			<div class="modal-head">
				<div class="modal-title">
					<h3 id="move-order-title">Sposta { num } su un'altra inserzione</h3>
					<span class="muted">Ora è collegato a: { current }. I clienti dell'ordine diventano quelli che hanno risposto alla nuova inserzione.</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()</button>
			</div>
			<div class="modal-body">
				<input type="search" placeholder="Cerca un'inserzione…" data-filter=".move-item" aria-label="Cerca un'inserzione"/>
				<div class="move-list">
					for _, x := range rows {
						<button
							type="submit"
							class="move-item"
							name="to"
							value={ q("chat", x.ChatID, "c", x.Key) }
							data-name={ x.Number + " " + x.DisplayTitle + " " + x.ChatName }
							disabled?={ otherOrder(x, num, quotNum) != "" }
						>
							<span class="dl-day">{ dayMonthShort(x.Data) }</span>
							<span class="dl-main">
								<b class="dl-title">{ x.DisplayTitle }</b>
								<span class="muted dl-group">
									if x.Number != "" {
										{ x.Number } ·
									}
									if o := otherOrder(x, num, quotNum); o != "" {
										ha già l'ordine { o }
									} else if hasOrder(x, num, quotNum) {
										collegato a questo ordine
									} else {
										{ x.ChatName }
									}
								</span>
							</span>
						</button>
					}
				</div>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
			</div>
		</form>
	</dialog>
}

// otherOrder: the number of an order of the inserzione other than num.
func otherOrder(x service.CampaignRow, num string, quotNum map[int64]string) string {
	for _, id := range x.QuotationIDs {
		if n := quotNum[id]; n != "" && n != num {
			return n
		}
	}
	return ""
}

func hasOrder(x service.CampaignRow, num string, quotNum map[int64]string) bool {
	for _, id := range x.QuotationIDs {
		if quotNum[id] == num {
			return true
		}
	}
	return false
}

// NewProductModal: creates a product without leaving the page; opened from
// a wine field's suggestions ("+ Nuovo prodotto") with the typed name.
templ NewProductModal(id string) {
	<dialog id={ id } class="modal modal-address" data-modal-keep aria-labelledby={ id + "-title" }>
		<form class="modal-form" hx-post="/prodotti/create" hx-swap="none">
			<div class="modal-head">
				<div class="modal-title">
					<h3 id={ id + "-title" }>Nuovo prodotto</h3>
					<span class="muted">Solo il nome è obbligatorio; il resto si può completare in Prodotti.</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()</button>
			</div>
			<div class="modal-body address-fields">
				<label class="span2">Vino (con l'annata) <input type="text" name="description" required autocomplete="off" placeholder="Es. Château Langoa Barton 2022"/></label>
				<label>Cantina <input type="text" name="winery" autocomplete="off"/></label>
				<label>Area <input type="text" name="area" autocomplete="off" placeholder="Es. PAU, CHA"/></label>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
				<button type="submit" class="btn primary">Crea prodotto</button>
			</div>
		</form>
	</dialog>
}

// orderNeighborLink: the order before/after this one in the Ordini list.
templ orderNeighborLink(q *service.QuotationSummary, label string, left bool) {
	if q != nil {
		<a href={ templ.URL(previewURL(q.Number)) } class="btn icon-btn" title={ label + ": " + q.Number + " · " + q.Title } aria-label={ label }>
			if left {
				@IconChevronLeft()
			} else {
				@IconChevronRight()
			}
		</a>
	} else {
		<button type="button" class="btn icon-btn" disabled aria-label={ label }>
			if left {
				@IconChevronLeft()
			} else {
				@IconChevronRight()
			}
		</button>
	}
}

// stockOver reports an option ordered beyond its availability.
func stockOver(stock []service.OptionStock) bool {
	for _, o := range stock {
		if o.Excess() > 0 {
			return true
		}
	}
	return false
}

// StockSummary: for each wine option, the bottles ordered and how many are
// still available (red when ordered beyond availability).
templ StockSummary(qnum string, stock []service.OptionStock) {
	if len(stock) > 0 {
		<section class={ "stock-summary", templ.KV("stock-over", stockOver(stock)) } aria-label="Ordinato e disponibile">
			if stockOver(stock) {
				<b class="stock-alert">Attenzione: alcune opzioni sono state ordinate oltre la disponibilità.</b>
			}
			<ul>
				for _, o := range stock {
					<li class={ templ.KV("over", o.Excess() > 0) }>
						<span class="stock-opt">{ o.Letter }</span>
						<span class="stock-wine">{ noEmoji(o.Wine) }</span>
						if o.Code != "" {
							<span class="stock-sale">
								if o.CaseSize > 0 {
									cassa da { itoa(o.CaseSize) } · € { money(o.Price) }
								} else {
									a bottiglia · € { money(o.Price) }
								}
								<button type="button" class="btn small" data-modal-show={ "opt-" + o.Code } aria-label={ "Modifica come si vende l'opzione " + o.Letter }>Cassa</button>
							</span>
						}
						<span class="stock-nums">
							<span>ordinate <b>{ itoa(o.Ordered) }</b></span>
							if o.HasCount {
								<span>disponibili <b>{ itoa(o.Offered) }</b></span>
								if o.Excess() > 0 {
									<span>restano <b>0</b> · <b>{ itoa(o.Excess()) } in più</b></span>
								} else {
									<span>restano <b>{ itoa(o.Remaining()) }</b></span>
								}
							} else {
								<span class="muted">disponibilità non indicata</span>
							}
						</span>
					</li>
				}
			</ul>
		</section>
		for _, o := range stock {
			if o.Code != "" {
				@optionCaseModal(qnum, o)
			}
		}
	}
}

// optionCaseModal: how option o is sold. Bottles per case 0 = by the bottle
// (price per bottle); 6, 12… = a whole case at the price of the case, so
// "2B" counts 2 cases and their bottles. Saving reloads the page.
templ optionCaseModal(qnum string, o service.OptionStock) {
	<dialog id={ "opt-" + o.Code } class="modal modal-address" data-modal-keep aria-labelledby={ "opt-" + o.Code + "-title" }>
		<form class="modal-form" hx-post="/ordini/opzione" hx-swap="none">
			<input type="hidden" name="n" value={ qnum }/>
			<input type="hidden" name="code" value={ o.Code }/>
			<div class="modal-head">
				<div class="modal-title">
					<h3 id={ "opt-" + o.Code + "-title" }>Opzione { o.Letter }</h3>
					<span class="muted">{ noEmoji(o.Wine) }</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()</button>
			</div>
			<div class="modal-body address-fields">
				<label>
					Bottiglie per cassa
					<input type="number" name="size" min="0" max="99" step="1" inputmode="numeric" value={ itoa(o.CaseSize) } required/>
				</label>
				<label>
					Prezzo (€)
					<input type="text" name="price" inputmode="decimal" value={ num(o.Price) } required/>
				</label>
				<p class="muted span2 modal-note">0 bottiglie = si vende a bottiglia (prezzo a bottiglia). 6 o 12 = cassa intera (prezzo della cassa): “2{ o.Letter }” vale 2 casse. Gli ordini già confermati non cambiano: usa “Riapri”.</p>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
				<button type="submit" class="btn primary">Salva</button>
			</div>
		</form>
	</dialog>
}

// ClientiDatalist: the customers offered by "Modifica cliente" in every
// section of the page.
templ ClientiDatalist(sections []service.CustomerSection) {
	<datalist id="clienti-list">
		for _, c := range clientChoices(sections) {
			<option value={ c }></option>
		}
	</datalist>
}

// CustomerSection: one customer's order. clientErr reopens the "Modifica
// cliente" modal with that error.
templ CustomerSection(qnum string, sec service.CustomerSection, msg, errMsg, clientErr string) {
	<form
		id={ sectionID(sec.Utente) }
		class="card cust-section"
		data-name={ sec.Cliente + " " + sec.Utente + " " + sec.Citta + " " + sec.Provincia }
		hx-post="/ordini/section"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="n" value={ qnum }/>
		<input type="hidden" name="utente" value={ sec.Utente }/>
		<input type="hidden" name="cliente" value={ sec.Cliente }/>
		<div class="card-head">
			<span class="client-row">
				<b class="client-name">{ sec.Cliente }</b>
				if p := sec.Place(); p != "" {
					<span class="muted client-place">{ p }</span>
				}
				<button type="button" class="btn small" data-modal-show={ sectionID(sec.Utente) + "-cliente" }>Cambia</button>
				<span class="nowrap">€ { money(sec.Total()) }</span>
			</span>
			if sec.SavedOn != "" {
				<span class="section-actions">
					<span class="badge badge-ok">Confermato il { sec.SavedOn }</span>
					<button
						type="button"
						class="btn small"
						hx-post="/ordini/section"
						hx-vals='{"op": "reopen"}'
						hx-target="closest form"
						hx-swap="outerHTML"
						hx-confirm={ "Riaprire l'ordine di " + sec.Cliente + "? L'ordine confermato viene cancellato e le righe tornano quelle delle risposte, da confermare di nuovo." }
					>Riapri</button>
				</span>
			} else {
				<span class="section-actions">
					<button type="button" class="btn" data-modal-show={ sectionID(sec.Utente) + "-vino" }>＋ Aggiungi vino</button>
					<button type="submit" name="op" value="save" class="btn primary">Conferma ordine</button>
				</span>
			}
		</div>
		if msg != "" {
			@Alert("success", msg)
		}
		if sec.Cliente != sec.Utente {
			<p class="muted">Nome originale rilevato: { sec.Utente }</p>
		}
		@clientModal(sec, clientErr)
		if len(sec.Rows) == 0 {
			<p class="muted">Nessuna riga.</p>
		} else {
			<table class="table">
				<thead>
					<tr>
						<th>Vino</th>
						<th class="num">Qtà</th>
						<th class="num">Prezzo (€)</th>
						<th class="num">Totale (€)</th>
						if sec.Manual {
							<th class="col-consegna">Consegna stimata</th>
							<th class="col-link">Inserzione</th>
						}
						if sec.SavedOn == "" {
							<th class="num"></th>
						}
					</tr>
				</thead>
				<tbody>
					for i, r := range sec.Rows {
						<tr>
							<td class="title-cell">
								<span class="wine-cell">
									@optTag(r.Opzione)
									{ noEmoji(r.Vino) }
								</span>
								<input type="hidden" name="opz" value={ r.Opzione }/>
								<input type="hidden" name="vino" value={ r.Vino }/>
								<input type="hidden" name="qta" value={ itoa(r.Qta) }/>
								<input type="hidden" name="prezzo" value={ num(r.Prezzo) }/>
							</td>
							<td class="num">{ itoa(r.Qta) }</td>
							<td class="num">{ money(r.Prezzo) }</td>
							<td class="num">{ money(r.Totale()) }</td>
							if sec.Manual {
								<td class="col-consegna">
									if d, ok := sec.Consegne[strings.ToUpper(r.Opzione)]; ok && r.Opzione != "" {
										@itemDate(sec.QuotationID, r, d)
									} else {
										<span class="muted">–</span>
									}
								</td>
								<td class="col-link">
									if d, ok := sec.Consegne[strings.ToUpper(r.Opzione)]; ok && r.Opzione != "" {
										@itemLink(sec.QuotationID, r, d)
									}
								</td>
							}
							if sec.SavedOn == "" {
								<td class="num">
									if sec.Manual && r.Opzione != "" {
										<button
											type="button"
											class="icon danger"
											title="Rimuovi riga"
											aria-label="Rimuovi riga"
											hx-post="/ordini/section"
											hx-vals={ templ.JSONString(map[string]string{"op": "del:" + itoa(i)}) }
											hx-target="closest form"
											hx-swap="outerHTML"
											hx-confirm={ "Togliere " + noEmoji(r.Vino) + " dall'ordine?" }
										>@IconX()
</button>
									} else {
										<button type="submit" name="op" value={ "del:" + itoa(i) } class="icon danger" title="Rimuovi riga" aria-label="Rimuovi riga">@IconX()
</button>
									}
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		}
		if sec.SavedOn == "" {
			@addWineModal(sec, errMsg)
		}
	</form>
}

// addWineModal adds a wine (from Prodotti) to the customer's order. Like
// clientModal it sits inside the section's form, so the draft rows travel
// with it; errMsg reopens it with the error.
templ addWineModal(sec service.CustomerSection, errMsg string) {
	<dialog
		id={ sectionID(sec.Utente) + "-vino" }
		class="modal modal-wine"
		data-modal-keep
		if errMsg != "" {
			data-modal-open
		}
		aria-labelledby={ sectionID(sec.Utente) + "-vino-title" }
	>
		<div class="modal-form">
			<div class="modal-head">
				<div class="modal-title">
					<h3 id={ sectionID(sec.Utente) + "-vino-title" }>Aggiungi un vino all'ordine</h3>
					<span class="muted">{ sec.Cliente }</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()
</button>
			</div>
			<div class="modal-body">
				if errMsg != "" {
					@Alert("error", errMsg)
				}
				<label class="add-wine">
					Vino (dai Prodotti)
					<input type="text" name="new_vino" list="prodotti-list" placeholder="Scrivi per cercare tra i Prodotti…" autocomplete="off"/>
				</label>
				<div class="add-wine-nums">
					<label>
						Quantità
						<input type="number" name="new_qta" min="1" step="1" value="1"/>
					</label>
					<label>
						Prezzo (€)
						<input type="number" name="new_prezzo" min="0" step="0.01" placeholder="0,00"/>
					</label>
				</div>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
				<button type="submit" name="op" value="add" class="btn primary">＋ Aggiungi</button>
			</div>
		</div>
	</dialog>
}

// clientModal changes the section's customer. It sits inside the section's
// form, so the draft rows travel with the change.
templ clientModal(sec service.CustomerSection, errMsg string) {
	<dialog
		id={ sectionID(sec.Utente) + "-cliente" }
		class="modal modal-client"
		data-modal-keep
		if errMsg != "" {
			data-modal-open
		}
		aria-labelledby={ sectionID(sec.Utente) + "-cliente-title" }
	>
		<div class="modal-form">
			<div class="modal-head">
				<div class="modal-title">
					<h3 id={ sectionID(sec.Utente) + "-cliente-title" }>Modifica cliente</h3>
					<span class="muted">Attuale: { sec.Cliente }</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()
</button>
			</div>
			<div class="modal-body">
				if errMsg != "" {
					@Alert("error", errMsg)
				}
				<label>
					Nuovo cliente
					<input type="text" name="new_cliente" list="clienti-list" placeholder="Scrivi per cercare un cliente..." autocomplete="off"/>
				</label>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn" data-modal-close>Annulla</button>
				<button type="submit" class="btn primary" name="op" value="cliente">Salva</button>
			</div>
		</div>
	</dialog>
}

type NuovoPreventivoData struct {
	Number  string
	Date    string
	Clients []string
	Cliente string
	Catalog []service.CatalogEntry
	Rows    []service.NewQuotationRow
	Camps   []NpCamp
	Error   string
}

// NpCamp is an inserzione a wine of a new order can be taken from.
type NpCamp struct {
	Label   string // unique: title · date
	Chat    string
	Options []service.LinkTarget
}

// Camp finds an inserzione by its label.
func (d NuovoPreventivoData) Camp(label string) *NpCamp {
	for i := range d.Camps {
		if d.Camps[i].Label == label {
			return &d.Camps[i]
		}
	}
	return nil
}

// Option finds one of the inserzione's wines.
func (c *NpCamp) Option(qid int64, letter string) *service.LinkTarget {
	for i := range c.Options {
		if c.Options[i].QuotationID == qid && c.Options[i].Letter == letter {
			return &c.Options[i]
		}
	}
	return nil
}

// npCampsJSON: label → wines, read by app.js to fill the wine select.
func npCampsJSON(camps []NpCamp) map[string][]map[string]any {
	out := make(map[string][]map[string]any, len(camps))
	for _, c := range camps {
		for _, o := range c.Options {
			out[c.Label] = append(out[c.Label], map[string]any{"v": i64(o.QuotationID) + ":" + o.Letter, "t": npOptText(o), "p": money(o.Price)})
		}
	}
	return out
}

func npOptText(o service.LinkTarget) string {
	t := o.Letter + " · " + noEmoji(o.Wine)
	if o.Price > 0 {
		t += " · " + strings.ReplaceAll(money(o.Price), ".", ",") + " €"
	}
	return t
}

func npSrc(r service.NewQuotationRow) string {
	if r.Source == "i" {
		return "i"
	}
	return "p"
}

templ NuovoPreventivo(d NuovoPreventivoData) {
	@Layout("Nuovo ordine", "ordini") {
		<div class="page-head">
			<a href="/ordini" class="btn icon-btn" title="Elenco" aria-label="Elenco">@IconList()</a>
			<h2>Nuovo ordine</h2>
		</div>
		if d.Error != "" {
			@Alert("error", d.Error)
		}
		@NewCustomerModal("np-new-client")
		@NewProductModal("np-new-product")
		<form method="post" action="/ordini/nuovo" class="stack" id="np-form">
			<div class="np-head">
				<div class="np-number"><b>Numero ordine:</b> <code>{ d.Number }</code></div>
				<label>
					Cliente
					<input type="text" name="cliente" list="np-clients" value={ d.Cliente } placeholder="Scrivi per cercare un cliente..." autocomplete="off" required data-new-customer="np-new-client"/>
				</label>
				<label>Data <input type="date" name="date" value={ d.Date } required/></label>
			</div>
			<datalist id="np-clients">
				for _, c := range d.Clients {
					<option value={ c }></option>
				}
			</datalist>
			<hr/>
			<h3>Vini</h3>
			<p class="muted np-help">Per ogni vino scegli se prenderlo dai <b>Prodotti</b> o da un'<b>inserzione</b>: dall'inserzione il prezzo si compila da solo e il vino resta collegato all'inserzione (data di consegna e disponibilità).</p>
			<datalist id="catalog">
				for _, e := range d.Catalog {
					<option value={ e.Label() }></option>
				}
			</datalist>
			<datalist id="np-camps">
				for _, c := range d.Camps {
					<option value={ c.Label }>{ c.Chat }</option>
				}
			</datalist>
			@templ.JSONScript("np-camps-data", npCampsJSON(d.Camps))
			<table class="table np-rows" id="np-rows">
				<thead><tr><th>N.</th><th>Vino</th><th>Quantità</th><th>Prezzo €</th></tr></thead>
				<tbody>
					for i, r := range d.Rows {
						@npRow(d, itoa(i+1), r)
					}
					<template>
						@npRow(d, "__N__", service.NewQuotationRow{Quantity: 1})
					</template>
				</tbody>
			</table>
			<div class="row between">
				<button type="button" class="btn" data-add-row="#np-rows" data-max="10">＋ Aggiungi</button>
				<button type="submit" class="btn primary">Crea</button>
			</div>
			<p class="muted">Sono salvate le righe con un vino e un prezzo maggiore di zero. Un vino che non è nei Prodotti si crea con «+ Nuovo prodotto».</p>
		</form>
	}
}

// npRow: one wine of a new order, taken from Prodotti or from an inserzione
// (inserzione + its wine). The fields of both stay in the form so the arrays
// line up; "src" says which one counts.
templ npRow(d NuovoPreventivoData, n string, r service.NewQuotationRow) {
	<tr data-src={ npSrc(r) }>
		<td class="title-cell np-n"><b>{ n }</b></td>
		<td class="wide np-pick">
			<input type="hidden" name="src" value={ npSrc(r) }/>
			<div class="seg np-src" role="group" aria-label="Prendi il vino da">
				<button type="button" class={ "seg-btn", templ.KV("active", npSrc(r) == "p") } data-src="p" aria-pressed={ boolStr(npSrc(r) == "p") }>Prodotti</button>
				<button type="button" class={ "seg-btn", templ.KV("active", npSrc(r) == "i") } data-src="i" aria-pressed={ boolStr(npSrc(r) == "i") }>Inserzione</button>
			</div>
			<div class="np-fields np-prod">
				<span class="np-field">
					<input type="text" name="vino" list="catalog" value={ r.WineName } placeholder="Cerca un prodotto..." aria-label="Prodotto" data-new-product="np-new-product"/>
				</span>
			</div>
			<div class="np-fields np-ins">
				<span class="np-field">
					<input type="text" name="camp" list="np-camps" class="np-camp" value={ r.Camp } placeholder="Cerca un'inserzione..." aria-label="Inserzione"/>
				</span>
				<select name="opt" class="np-opt" aria-label="Vino dell'inserzione">
					<option value="">Scegli il vino...</option>
					if c := d.Camp(r.Camp); c != nil {
						for _, o := range c.Options {
							<option value={ i64(o.QuotationID) + ":" + o.Letter } data-price={ money(o.Price) } selected?={ o.QuotationID == r.LinkQuotation && o.Letter == r.LinkOption }>{ npOptText(o) }</option>
						}
					}
				</select>
			</div>
		</td>
		<td><input type="number" name="qta" min="1" step="1" value={ itoa(r.Quantity) } inputmode="numeric"/></td>
		<td><input type="number" name="prezzo" min="0" step="0.01" value={ money(r.Price) } inputmode="decimal"/></td>
	</tr>
}
