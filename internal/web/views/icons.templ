package views

// Inline SVG icons (no emoji anywhere in the UI): they inherit the text
// colour, so they work in light and dark theme.

templ IconX() {
	<svg class="icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
}

templ IconSun() {
	<svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
}

templ IconMoon() {
	<svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
}

templ IconCheck() {
	<svg class="icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>
}

templ IconHand() {
	<svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 11V6a2 2 0 0 0-4 0"></path><path d="M14 10V4a2 2 0 0 0-4 0v2"></path><path d="M10 10.5V6a2 2 0 0 0-4 0v8"></path><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path></svg>
}

// IconList: a bulleted list ("Elenco", back to the list).
templ IconList() {
	<svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"></path><path d="M4 6h.01M4 12h.01M4 18h.01" stroke-width="3"></path></svg>
}

templ IconChevronLeft() {
	<svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
}

templ IconChevronRight() {
	<svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
}

// IconExcel: a spreadsheet file with an "X" (Excel download).
templ IconExcel() {
	<svg class="icon-svg icon-excel" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 2.75h7.5L20.25 7.5v12.75a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V3.75a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M15.5 2.75V7.5h4.75" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M11 11.5h6.5M11 14.5h6.5M11 17.5h6.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" opacity=".55"></path><rect x="2.75" y="9.25" width="8.5" height="8.5" rx="1.25" fill="currentColor"></rect><path d="M5.25 11.5l3.5 4M8.75 11.5l-3.5 4" stroke="var(--panel)" stroke-width="1.6" stroke-linecap="round"></path></svg>
}

// IconSparkles: a large and two small four-pointed stars (AI action).
templ IconSparkles() {
	<svg class="icon-svg icon-ai" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 3.5c.4 3.6 2.4 5.6 6 6-3.6.4-5.6 2.4-6 6-.4-3.6-2.4-5.6-6-6 3.6-.4 5.6-2.4 6-6z"></path><path d="M18 2c.2 1.7 1.1 2.6 2.8 2.8-1.7.2-2.6 1.1-2.8 2.8-.2-1.7-1.1-2.6-2.8-2.8 1.7-.2 2.6-1.1 2.8-2.8z"></path><path d="M17.5 14.5c.2 1.9 1.2 2.9 3.1 3.1-1.9.2-2.9 1.2-3.1 3.1-.2-1.9-1.2-2.9-3.1-3.1 1.9-.2 2.9-1.2 3.1-3.1z"></path></svg>
}

// IconBell: notifications (new orders).
templ IconBell() {
	<svg class="icon-svg icon-bell" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8.5a6 6 0 0 1 12 0c0 4.6 1.4 6.6 2.3 7.6a.5.5 0 0 1-.37.9H4.07a.5.5 0 0 1-.37-.9C4.6 15.1 6 13.1 6 8.5z"></path><path d="M10 20.25a2.1 2.1 0 0 0 4 0"></path></svg>
}

// IconGrid: four squares (sections shortcut).
templ IconGrid() {
	<svg class="icon-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"></rect><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"></rect><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"></rect><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"></rect></svg>
}

// IconMegaphone: a listing announced in the chat (Inserzioni).
templ IconMegaphone() {
	<svg class="icon-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5v3a1.5 1.5 0 0 0 1.5 1.5H7l6 4.5V4.5L7 9H4.5A1.5 1.5 0 0 0 3 10.5z"></path><path d="M7 15l1.2 4.2a1.2 1.2 0 0 0 1.15.8h.9a1 1 0 0 0 .96-1.28L10.5 16.6"></path><path d="M17 9a4 4 0 0 1 0 6"></path><path d="M19.5 6.5a7.5 7.5 0 0 1 0 11"></path></svg>
}

// IconReceipt: an order with its lines (Ordini).
templ IconReceipt() {
	<svg class="icon-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 3h13v18l-2.6-1.6L13.3 21l-2.6-1.6L8.1 21l-2.6-1.6V3z"></path><path d="M9 8h6M9 12h6M9 16h3.5"></path></svg>
}

// IconTruck: a delivery (Consegne).
templ IconTruck() {
	<svg class="icon-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.5a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1V16h-12V6.5z"></path><path d="M14.5 9.5h3.6l3.4 3.6V16h-7"></path><circle cx="7" cy="17.5" r="1.9"></circle><circle cx="17.5" cy="17.5" r="1.9"></circle></svg>
}

// IconMove: an arrow leaving a box (move a reply to another listing).
templ IconMove() {
	<svg class="icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"></path><path d="M3 12h11"></path><path d="M10 8l4 4-4 4"></path></svg>
}

// IconPhone: a handset (call the customer).
templ IconPhone() {
	<svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.08 4.18 2 2 0 0 1 4.06 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.04 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
}

// IconPen: a pen (an order corrected by hand).
templ IconPen() {
	<svg class="icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path><path d="M15 5l3 3"></path></svg>
}

// IconLink: two chain links (connected to an inserzione).
templ IconLink() {
	<svg class="icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
}

// IconUnlink: a broken chain (disconnect from an inserzione).
templ IconUnlink() {
	<svg class="icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18.84 12.25l1.72-1.71a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M5.17 11.75l-1.71 1.71a5 5 0 0 0 7.07 7.07l1.71-1.71"></path><path d="M8 2v3M2 8h3M16 22v-3M22 16h-3"></path></svg>
}

// IconRomanI: a serif capital I, like Roman lettering (an inserzione).
templ IconRomanI() {
	<svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.5 3.5h11v1.6c-1.6.1-2.4.6-2.6 1.4-.1.4-.1 1-.1 1.8v7.4c0 .8 0 1.4.1 1.8.2.8 1 1.3 2.6 1.4v1.6h-11v-1.6c1.6-.1 2.4-.6 2.6-1.4.1-.4.1-1 .1-1.8V8.3c0-.8 0-1.4-.1-1.8-.2-.8-1-1.3-2.6-1.4z"></path></svg>
}

// IconRomanO: a capital O with Roman stress, thick sides and thin top and
// bottom (an order).
templ IconRomanO() {
	<svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M12 3c4.6 0 8 4 8 9s-3.4 9-8 9-8-4-8-9 3.4-9 8-9zm0 1.4c-2.3 0-3.7 3.3-3.7 7.6s1.4 7.6 3.7 7.6 3.7-3.3 3.7-7.6S14.3 4.4 12 4.4z"></path></svg>
}
