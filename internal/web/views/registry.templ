package views

import (
	"adesgo/internal/service"
	"fmt"
	"sort"
	"strings"
)

// ── Consegne ─────────────────────────────────────────────────────────────────

// selURL is path + "?sel=…" for the given campaign ids (excel, detail page,
// back link to the selection).
func selURL(path string, ids []string) string {
	var b strings.Builder
	b.WriteString(path + "?")
	for i, id := range ids {
		if i > 0 {
			b.WriteString("&")
		}
		b.WriteString("sel=" + id)
	}
	return b.String()
}

// ConsegnePage: campaigns grouped by month of publication, shown as a
// timeline or as cards (toggle, remembered in the browser). Ticking campaigns
// refreshes the summary bar; its button opens the deliveries page.
// consegneTabURL keeps the selection when switching tab.
func consegneTabURL(ids []string, manual bool) string {
	u := selURL("/consegne", ids)
	if manual {
		if strings.HasSuffix(u, "?") {
			return u + "vista=ordini"
		}
		return u + "&vista=ordini"
	}
	return u
}

// ConsegnePage: the listings with an order (Inserzioni tab, default) or the
// manual orders (Ordini tab), as a timeline to select from.
templ ConsegnePage(months []service.ConsegneMonth, selected map[string]bool, result *service.Consegne, ids []string, manual bool, hidden []service.ConsegneCampaign) {
	@Layout("Consegne", "consegne") {
		<div class="row between">
			<h2>Consegne</h2>
			<nav class="seg" aria-label="Inserzioni o ordini manuali">
				<a href={ templ.URL(consegneTabURL(ids, false)) } class={ "seg-btn", templ.KV("active", !manual) }
					if !manual {
						aria-current="page"
					}
				>Inserzioni</a>
				<a href={ templ.URL(consegneTabURL(ids, true)) } class={ "seg-btn", templ.KV("active", manual) }
					if manual {
						aria-current="page"
					}
				>Ordini</a>
			</nav>
		</div>
		if len(months) == 0 {
			if manual {
				@Alert("info", "Nessun ordine manuale.")
			} else {
				@Alert("info", "Nessuna inserzione con un ordine collegato.")
			}
			@ConsegneSelBar(result, ids)
		} else {
			<form id="consegne-form" hx-get="/consegne/result" hx-target="#sel-bar" hx-swap="outerHTML" hx-trigger="change" hx-disinherit="*">
				if manual {
					<input type="hidden" name="vista" value="ordini"/>
				}
				// selected in the other tab: stay in the selection
				for _, c := range hidden {
					<input type="hidden" name="sel" value={ c.ID }/>
				}
				<input type="search" placeholder="Filtra Consegne…" data-filter=".dl-item" class="narrow list-filter"/>
				<div class="consegne view-timeline">
					for _, m := range months {
						<section class="month" data-filter-group=".dl-item">
							<header class="month-head">
								<h3>{ monthLabel(m.Year, m.Month) }</h3>
								<span class="muted">
									if manual {
										{ plural(len(m.Campaigns), "ordine", "ordini") }
									} else {
										{ plural(len(m.Campaigns), "inserzione", "inserzioni") }
									}
									· { plural(m.Clienti, "cliente", "clienti") } · { itoa(m.Bottiglie) } bott. · € { money(m.Totale) }
								</span>
								<button type="button" class="btn small" data-check-all>Seleziona mese</button>
							</header>
							<div class="month-items">
								for _, c := range m.Campaigns {
									<label class={ "dl-item", templ.KV("dl-empty", c.Clienti == 0) } data-name={ c.Label }>
										<input type="checkbox" name="sel" value={ c.ID } checked?={ selected[c.ID] }/>
										<span class="dl-day">{ dayMonthShort(c.Published) }</span>
										<span class="dl-main">
											<b class="dl-title">{ c.Title }</b>
											<span class="muted dl-group">{ c.ChatName }</span>
										</span>
										<span class="dl-stats">
											if c.Clienti == 0 {
												<span>nessun ordine</span>
											} else {
												<span>{ plural(c.Clienti, "cliente", "clienti") }</span>
												<span>{ itoa(c.Bottiglie) } bott.</span>
												<b>€ { money(c.Totale) }</b>
											}
										</span>
									</label>
								}
							</div>
						</section>
					}
				</div>
			</form>
			@ConsegneSelBar(result, ids)
		}
	}
}

// ConsegneShowPage: the deliveries of the selected campaigns, on a page of
// its own (opened from the summary bar of ConsegnePage).
templ ConsegneShowPage(result *service.Consegne, ids []string) {
	@Layout("Consegne", "consegne") {
		<div class="page-head">
			<a href={ templ.URL(selURL("/consegne", ids)) } class="btn">← Elenco</a>
			<h2>Consegne selezionate</h2>
		</div>
		if len(result.Selected) > 0 {
			<p class="muted">
				for i, c := range result.Selected {
					if i > 0 {
						{ " · " }
					}
					{ dayMonthShort(c.Published) } { c.Title }
				}
			</p>
		}
		@ConsegneResult(result, ids)
	}
}

// oobAttrs marks an element for an out-of-band swap. The value must be
// "true" (outerHTML): a bare hx-swap-oob attribute makes htmx nest the new
// element inside the old one.
func oobAttrs(oob bool) templ.Attributes {
	if oob {
		return templ.Attributes{"hx-swap-oob": "true"}
	}
	return templ.Attributes{}
}

// ConsegneSelBar sticks to the bottom of the screen while scrolling the list,
// so the selection summary and the way to the table are always at hand.
templ ConsegneSelBar(r *service.Consegne, ids []string) {
	<div id="sel-bar" class="sel-bar">
		if len(r.Selected) > 0 {
			<span>
				<b>{ plural(len(r.Selected), "selezionato", "selezionati") }</b> · { plural(r.Clienti, "cliente", "clienti") } · { itoa(r.Bottiglie) } bott. · € { money(r.Totale) }
			</span>
			<a href={ templ.URL(selURL("/consegne/show", ids)) } class="btn primary small">Vedi consegne →</a>
		}
	</div>
}

templ ConsegneResult(r *service.Consegne, ids []string) {
	switch {
		case len(r.Selected) == 0:
			@Alert("info", "Seleziona una o più inserzioni (o un intero mese) per vedere le consegne.")
		case r.NoQuote:
			@Alert("warning", "Nessun ordine collegato alle inserzioni selezionate.")
		case len(r.Customers) == 0:
			@Alert("info", "Nessun vino selezionato dai clienti per le inserzioni scelte.")
		default:
			@PlaceDatalists()
			<div class="row between">
				<h3>Riepilogo</h3>
				<a href={ templ.URL(selURL("/consegne/excel", ids)) } hx-boost="false" download class="btn icon-btn" title="Scarica Excel" aria-label="Scarica Excel">@IconExcel()</a>
			</div>
			<div class="metrics">
				<div class="metric"><span>Inserzioni</span><b>{ itoa(len(r.Selected)) }</b></div>
				<div class="metric"><span>Clienti</span><b>{ itoa(r.Clienti) }</b></div>
				<div class="metric"><span>Bottiglie</span><b>{ itoa(r.Bottiglie) }</b></div>
				<div class="metric"><span>Totale (€)</span><b>{ money(r.Totale) }</b></div>
			</div>
			if n := clientsWithoutProvincia(r); n > 0 {
				@Alert("info", plural(n, "cliente non ha", "clienti non hanno")+" la provincia: clicca sul nome del cliente per inserirla.")
			}
			<div class="table-wrap">
				<table class="table deliveries">
					<thead><tr><th>Vino</th><th>Inserzione</th><th class="num">Qtà</th><th class="num">Prezzo (€)</th><th class="num">Totale (€)</th></tr></thead>
					<tbody>
						for _, a := range r.Areas {
							<tr class="area-row">
								<td class="title-cell" colspan="5" data-label="">
									{ placeOr(a.Provincia, "Provincia non indicata") }
									<span class="muted dl-meta"><span>{ plural(a.Clienti, "cliente", "clienti") }</span><span>{ itoa(a.Bottiglie) } bott.</span><span>€ { money(a.Totale) }</span></span>
								</td>
							</tr>
							for _, city := range a.Cities {
								<tr class="city-row">
									<td class="title-cell" colspan="5" data-label="">
										{ placeOr(city.Citta, "Città non indicata") }
										<span class="muted dl-meta"><span>{ plural(len(city.Customers), "cliente", "clienti") }</span><span>{ itoa(city.Bottiglie) } bott.</span></span>
									</td>
								</tr>
								for _, c := range city.Customers {
									@deliveryCustomer(c)
								}
							}
						}
					</tbody>
				</table>
			</div>
	}
}

// deliveryAddressModal: the customer's delivery address, editable in place;
// every field saves by itself on leaving it, as in Clienti. Closing it after
// a change reloads the page, so the customer moves to their new area.
templ deliveryAddressModal(c service.CustomerDelivery) {
	<dialog
		id={ "dlv-" + sectionID(c.UserID) }
		class="modal modal-address"
		data-modal-keep
		data-reload-on-save
		data-autosave-who={ c.Cliente }
		aria-labelledby={ "dlv-" + sectionID(c.UserID) + "-title" }
	>
		<div class="modal-form">
			<div class="modal-head">
				<div class="modal-title">
					<h3 id={ "dlv-" + sectionID(c.UserID) + "-title" }>{ c.Cliente }</h3>
					<span class="muted">Indirizzo di consegna · si salva da solo quando esci dal campo</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()</button>
			</div>
			<div class="modal-body address-fields">
				<label class="span2">
					Indirizzo
					@autosaveField("/clienti/field", c.UserID, "indirizzo", c.Indirizzo, "Indirizzo", "", false)
				</label>
				<label>
					Città
					@autosaveField("/clienti/field", c.UserID, "citta", c.Citta, "Città", "", false)
				</label>
				<label>
					Provincia
					@autosaveInput("/clienti/field", c.UserID, "provincia", c.Provincia, "Provincia", "", false, provinciaAttrs)
				</label>
				<label>
					CAP
					@autosaveField("/clienti/field", c.UserID, "cap", c.CAP, "CAP", "", false)
				</label>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn primary" data-modal-close>Fatto</button>
			</div>
		</div>
	</dialog>
}

// deliveryCustomer: a customer's header row and their lines.
templ deliveryCustomer(c service.CustomerDelivery) {
							<tr class="group-row">
								<td class="title-cell" colspan="5" data-label="">
									if c.UserID != "" {
										<button type="button" class="client-pill" data-modal-show={ "dlv-" + sectionID(c.UserID) } title="Indirizzo di consegna">{ c.Cliente }</button>
										@deliveryAddressModal(c)
									} else {
										{ c.Cliente }
									}
									<span class="muted dl-meta"><span>{ itoa(c.Bottiglie) } bott.</span><span>€ { money(c.Totale) }</span></span>
								</td>
							</tr>
							for _, l := range c.Lines {
								<tr class={ templ.KV("manual-line", l.Manual) }>
									<td class="title-cell">{ noEmoji(l.Vino) }</td>
									<td>
										<a href={ templ.URL(l.URL) }>{ l.Inserzione }</a>
										if l.Manual && l.Order != "" {
											<a href={ templ.URL("/ordini/view?n=" + l.Order) } class="manual-badge" title="Questo vino viene da un ordine manuale">
												@IconHand()
												<span>Ordine manuale { l.Order }</span>
											</a>
										}
									</td>
									<td class="num">{ itoa(l.Qta) }</td>
									<td class="num">{ money(l.Prezzo) }</td>
									<td class="num">{ money(l.Totale()) }</td>
								</tr>
							}
}

// ── Clienti ──────────────────────────────────────────────────────────────────

// ClientiPage: every field saves by itself when you leave it (if changed),
// see autosaveField + app.js [data-autosave]. No "Salva" button.
templ ClientiPage(users []service.User) {
	@Layout("Clienti", "clienti") {
		<div class="row between">
			<h2>Clienti</h2>
			<div class="row">
				<a href="/clienti/unisci" class="btn">Unisci duplicati</a>
				<button
					type="button"
					class="btn primary"
					hx-post="/clienti/new"
					hx-target="#clienti-body"
					hx-swap="afterbegin"
				>＋ Aggiungi</button>
			</div>
		</div>
		<div class="row between">
			<div class="row">
				<input type="search" placeholder="Cerca cliente…" data-filter=".user-row" class="narrow"/>
				<span class="muted" data-filter-count=".user-row" data-noun="clienti">{ fmt.Sprint(len(users)) } clienti</span>
			</div>
			<span class="muted">Le modifiche si salvano da sole quando esci dal campo.</span>
		</div>
		@PlaceDatalists()
		@CittaDatalist(users)
		<div class="table-wrap sticky-head">
			<table class="table edit autosave clienti">
				<thead>
					<tr>
						@filterTh("Codice / ID")
						@filterTh("Nome")
						@filterTh("Telefono")
						@filterTh("Partita IVA")
						@filterTh("Indirizzo")
						@filterTh("Città")
						@filterTh("Provincia")
						@filterTh("Regione")
						@filterTh("CAP")
						<th class="num col-del"></th>
						<th class="col-more"></th>
					</tr>
				</thead>
				<tbody id="clienti-body">
					for _, u := range users {
						@ClienteRow(u, false)
					}
				</tbody>
			</table>
		</div>
	}
}

// customerIDsTitle: all the ids of a customer, for the tooltip.
func customerIDsTitle(u service.User) string {
	t := u.ID
	for _, a := range u.Aliases {
		t += "\n" + a
	}
	return t
}

// MergePage: suggested duplicates (best first), a free merge, and the
// merges done (with "Separa").
templ MergePage(sugg []service.MergeSuggestion, merged []service.MergedCustomer, names []string) {
	@Layout("Unisci clienti", "clienti") {
		<div class="page-head">
			<a href="/clienti" class="btn">← Clienti</a>
			<h2>Unisci clienti duplicati</h2>
		</div>
		<p class="muted">
			Lo stesso cliente può comparire più volte: con il nome della chat importata, con il suo ID WhatsApp, o aggiunto a mano.
			Unendoli, ordini e consegne di tutti gli ID vanno al cliente principale. Si può sempre separare.
		</p>
		<form class="card merge-free" hx-post="/clienti/unisci" hx-swap="none">
			<b>Unisci a mano</b>
			<div class="merge-free-row">
				<label>Cliente duplicato <input type="text" name="alias" list="merge-clients" placeholder="Scrivi per cercare…" autocomplete="off" required/></label>
				<span class="merge-arrow">→</span>
				<label>Nel cliente principale <input type="text" name="main" list="merge-clients" placeholder="Scrivi per cercare…" autocomplete="off" required/></label>
				<button type="submit" class="btn primary">Unisci</button>
			</div>
			<datalist id="merge-clients">
				for _, n := range names {
					<option value={ n }></option>
				}
			</datalist>
		</form>
		<h3>Possibili duplicati <span class="muted">({ itoa(len(sugg)) })</span></h3>
		if len(sugg) == 0 {
			@Alert("info", "Nessun possibile duplicato trovato.")
		}
		<div class="merge-list">
			for _, m := range sugg {
				<div class="merge-item">
					@mergeSide(m.Alias)
					<span class="merge-arrow" aria-hidden="true">→</span>
					@mergeSide(m.Main)
					<div class="merge-why">
						for _, r := range m.Reasons {
							<span class="badge badge-info">{ r }</span>
						}
					</div>
					<button
						type="button"
						class="btn small primary"
						hx-post="/clienti/unisci"
						hx-vals={ templ.JSONString(map[string]string{"alias_id": m.Alias.ID, "main_id": m.Main.ID}) }
						hx-swap="none"
						hx-confirm={ "Unire «" + m.Alias.Name + "» in «" + m.Main.Name + "»?" }
					>Unisci</button>
				</div>
			}
		</div>
		if len(merged) > 0 {
			<h3>Clienti uniti <span class="muted">({ itoa(len(merged)) })</span></h3>
			<div class="merge-list">
				for _, m := range merged {
					<div class="merge-item">
						<span><b>{ noEmoji(m.Name) }</b> <span class="muted mono">{ m.ID }</span></span>
						<span class="merge-arrow" aria-hidden="true">→</span>
						<span><span class="customer-code">{ m.MainCode }</span> <b>{ noEmoji(m.MainName) }</b></span>
						<button
							type="button"
							class="btn small"
							hx-post="/clienti/separa"
							hx-vals={ templ.JSONString(map[string]string{"id": m.ID}) }
							hx-swap="none"
							hx-confirm={ "Separare «" + m.Name + "» da «" + m.MainName + "»?" }
						>Separa</button>
					</div>
				}
			</div>
		}
	}
}

templ mergeSide(c service.MergeCandidate) {
	<span class="merge-side">
		<b>{ noEmoji(c.Name) }</b>
		<span class="muted merge-meta">
			if c.Code != "" {
				{ c.Code } ·
			}
			{ mergeKindLabel(c.Kind) } · { plural(c.Replies, "messaggio", "messaggi") }
			if c.First != "" {
				· { c.First } → { c.Last }
			}
		</span>
	</span>
}

func mergeKindLabel(k string) string {
	switch k {
	case "whatsapp":
		return "WhatsApp"
	case "import":
		return "chat importata"
	case "manual":
		return "aggiunto a mano"
	}
	return k
}

// deleteUserConfirm says what deleting the customer does to their messages.
func deleteUserConfirm(u service.User) string {
	name := u.Name
	if name == "" {
		name = "questo cliente"
	}
	if u.Replies == 0 {
		return "Eliminare " + name + "?"
	}
	msgs := "Il suo messaggio resta"
	if u.Replies > 1 {
		msgs = "I suoi " + itoa(u.Replies) + " messaggi restano"
	}
	return "Eliminare " + name + "? " + msgs + " nelle inserzioni con il solo ID WhatsApp al posto del nome; se scrive di nuovo nel gruppo, il cliente ricompare."
}

// ClienteRow is one customer; focus=true for a just-created one (cursor in Nome).
templ ClienteRow(u service.User, focus bool) {
	<tr class="user-row" data-name={ u.Name + " " + u.ID + " " + u.Citta + " " + u.Telefono + " " + u.PIVA }>
		<td class="mono title-cell col-id col-extra" title={ customerIDsTitle(u) }>
			@customerIDs(u)
		</td>
		<td class="wide col-nome">@autosaveField("/clienti/field", u.ID, "name", u.Name, "Nome", "", focus)</td>
		<td class="wide col-tel">
			<span class="tel-field">
				@autosaveField("/clienti/field", u.ID, "telefono", u.Telefono, "Telefono", "", false)
				if u.Telefono != "" {
					<a class="btn icon-btn tel-link" href={ templ.SafeURL("tel:" + u.Telefono) } hx-boost="false" title={ "Chiama " + u.Telefono } aria-label={ "Chiama " + u.Telefono }>@IconPhone()</a>
				}
			</span>
		</td>
		<td class="col-extra col-piva">@autosaveField("/clienti/field", u.ID, "piva", u.PIVA, "Partita IVA", "", false)</td>
		<td class="wide col-extra">@autosaveField("/clienti/field", u.ID, "indirizzo", u.Indirizzo, "Indirizzo", "", false)</td>
		<td class="col-extra">@autosaveInput("/clienti/field", u.ID, "citta", u.Citta, "Città", "", false, cittaAttrs)</td>
		<td class="col-extra">@autosaveInput("/clienti/field", u.ID, "provincia", u.Provincia, "Provincia", "", false, provinciaAttrs)</td>
		<td class="col-extra">@autosaveInput("/clienti/field", u.ID, "regione", u.Regione, "Regione", "", false, regioneAttrs)</td>
		<td class="col-extra">@autosaveField("/clienti/field", u.ID, "cap", u.CAP, "CAP", "short", false)</td>
		<td class="num col-del col-extra">
			@deleteRowButton("/clienti/delete", u.ID, deleteUserConfirm(u))
		</td>
		<td class="col-more">
			<button type="button" class="btn" data-modal-show={ "cli-" + sectionID(u.ID) }>Dettagli</button>
			@clienteDetailsModal(u)
		</td>
	</tr>
}

// customerIDs: the customer's code and WhatsApp id (or "aggiunto a mano"),
// plus how many other ids were merged into it.
templ customerIDs(u service.User) {
	if u.Code != "" {
		<span class="customer-code">{ u.Code }</span>
	}
	if service.IsManualUser(u.ID) {
		<span class="badge badge-warn">aggiunto a mano</span>
	} else {
		{ noEmoji(u.ID) }
	}
	if len(u.Aliases) > 0 {
		<span class="muted alias-count">+{ itoa(len(u.Aliases)) } ID</span>
	}
}

// clienteDetailsModal: on phones the Clienti cards show only Nome and
// Telefono; "Dettagli" opens the other fields here. They autosave like the
// table's (app.js copies a saved value to the same field in the table), and
// the dialog sits inside the row so "Elimina" removes the row.
templ clienteDetailsModal(u service.User) {
	<dialog id={ "cli-" + sectionID(u.ID) } class="modal modal-address" data-modal-keep aria-labelledby={ "cli-" + sectionID(u.ID) + "-title" }>
		<div class="modal-form">
			<div class="modal-head">
				<div class="modal-title">
					<h3 id={ "cli-" + sectionID(u.ID) + "-title" }>
						if u.Name != "" {
							{ u.Name }
						} else {
							Cliente
						}
					</h3>
					<span class="muted mono" title={ customerIDsTitle(u) }>@customerIDs(u)</span>
				</div>
				<button type="button" class="icon" data-modal-close aria-label="Chiudi">@IconX()</button>
			</div>
			<div class="modal-body address-fields">
				<span class="muted span2">Si salva da solo quando esci dal campo.</span>
				<label class="span2">
					Indirizzo
					@autosaveField("/clienti/field", u.ID, "indirizzo", u.Indirizzo, "Indirizzo", "", false)
				</label>
				<label>
					Città
					@autosaveInput("/clienti/field", u.ID, "citta", u.Citta, "Città", "", false, cittaAttrs)
				</label>
				<label>
					Provincia
					@autosaveInput("/clienti/field", u.ID, "provincia", u.Provincia, "Provincia", "", false, provinciaAttrs)
				</label>
				<label>
					Regione
					@autosaveInput("/clienti/field", u.ID, "regione", u.Regione, "Regione", "", false, regioneAttrs)
				</label>
				<label>
					CAP
					@autosaveField("/clienti/field", u.ID, "cap", u.CAP, "CAP", "", false)
				</label>
				<label class="span2">
					Partita IVA
					@autosaveField("/clienti/field", u.ID, "piva", u.PIVA, "Partita IVA", "", false)
				</label>
			</div>
			<div class="modal-foot">
				<button
					type="button"
					class="btn danger"
					hx-post="/clienti/delete"
					hx-vals={ templ.JSONString(map[string]string{"id": u.ID}) }
					hx-target="closest tr"
					hx-swap="outerHTML"
					hx-confirm={ deleteUserConfirm(u) }
				>Elimina cliente</button>
				<button type="button" class="btn primary" data-modal-close>Fatto</button>
			</div>
		</div>
	</dialog>
}

// provinciaAttrs / regioneAttrs: the fields suggest the dictionary entries
// (PlaceDatalists, on the page); the server accepts only those.
var provinciaAttrs = templ.Attributes{"list": "province-list", "autocomplete": "off"}
var regioneAttrs = templ.Attributes{"list": "regioni-list", "autocomplete": "off"}

// cittaAttrs: Città suggests the cities already used in Clienti
// (CittaDatalist) but takes anything typed.
var cittaAttrs = templ.Attributes{"list": "citta-list", "autocomplete": "off"}

// CittaDatalist: the customers' cities, once each (case and spaces ignored),
// in alphabetical order.
templ CittaDatalist(users []service.User) {
	<datalist id="citta-list">
		for _, c := range distinctCities(users) {
			<option value={ c }></option>
		}
	</datalist>
}

func distinctCities(users []service.User) []string {
	seen := map[string]bool{}
	var out []string
	for _, u := range users {
		c := strings.Join(strings.Fields(u.Citta), " ")
		k := strings.ToLower(c)
		if c == "" || seen[k] {
			continue
		}
		seen[k] = true
		out = append(out, c)
	}
	sort.Slice(out, func(i, j int) bool { return strings.ToLower(out[i]) < strings.ToLower(out[j]) })
	return out
}

// PlaceDatalists: the provinces ("Vicenza", with "VI · Veneto") and regions
// suggested by the provincia / regione fields.
templ PlaceDatalists() {
	<datalist id="province-list">
		for _, p := range service.Province() {
			<option value={ p.Nome }>{ p.Sigla } · { p.Regione }</option>
		}
	</datalist>
	<datalist id="regioni-list">
		for _, r := range service.Regioni() {
			<option value={ r }></option>
		}
	</datalist>
}

// filterTh is a column title with a filter box under it: rows whose value in
// this column doesn't contain the typed text are hidden (app.js
// [data-col-filter], combined with the page's search box). Phones hide the
// table header, so there only the search box filters.
templ filterTh(title string) {
	<th>
		{ title }
		<input type="search" class="col-filter" data-col-filter placeholder="Filtra" aria-label={ "Filtra " + title }/>
	</th>
}

// autosaveField posts only this field to url when it changes (fired on
// leaving it), with the row id and the field name.
templ autosaveField(url, id, field, value, label, class string, focus bool) {
	@autosaveInput(url, id, field, value, label, class, focus, nil)
}

// autosaveInput is autosaveField with extra attributes (e.g. maxlength).
templ autosaveInput(url, id, field, value, label, class string, focus bool, attrs templ.Attributes) {
	<input
		name="value"
		value={ value }
		class={ class }
		aria-label={ label }
		autofocus?={ focus }
		{ attrs... }
		data-autosave
		hx-post={ url }
		hx-trigger="change"
		hx-swap="none"
		hx-vals={ templ.JSONString(map[string]string{"id": id, "field": field}) }
	/>
}

// deleteRowButton removes its table row after confirmation.
templ deleteRowButton(url, id, confirm string) {
	<button
		type="button"
		class="icon danger"
		title="Elimina"
		aria-label="Elimina"
		hx-post={ url }
		hx-vals={ templ.JSONString(map[string]string{"id": id}) }
		hx-target="closest tr"
		hx-swap="outerHTML"
		hx-confirm={ confirm }
	>@IconX()</button>
}

// ── Prodotti ─────────────────────────────────────────────────────────────────

// ProdottiPage: same autosave as Clienti; "+ Aggiungi" creates the product
// right away (next ITM code) with the cursor in Descrizione.
templ ProdottiPage(items []service.Item) {
	@Layout("Prodotti", "prodotti") {
		<div class="row between">
			<h2>Prodotti</h2>
			<button
				type="button"
				class="btn primary"
				hx-post="/prodotti/new"
				hx-target="#prodotti-body"
				hx-swap="afterbegin"
			>＋ Aggiungi</button>
		</div>
		<div class="row between">
			<input type="search" placeholder="Cerca prodotto…" data-filter=".item-row" class="narrow"/>
			<span class="muted">Le modifiche si salvano da sole quando esci dal campo.</span>
		</div>
		<div class="table-wrap sticky-head">
			<table class="table edit autosave">
				<thead><tr><th>Codice</th><th class="col-erp">Codice ERP</th><th>Descrizione</th><th>Cantina</th><th>Area</th><th class="num"></th></tr></thead>
				<tbody id="prodotti-body">
					for _, it := range items {
						@ProdottoRow(it, false)
					}
				</tbody>
			</table>
		</div>
	}
}

templ ProdottoRow(it service.Item, focus bool) {
	<tr class="item-row" data-name={ it.Code + " " + it.CodeAlias + " " + it.Description + " " + it.Winery + " " + it.Area }>
		<td class="mono code-cell title-cell">
			if it.Code != "" {
				{ it.Code }
			} else {
				<span class="muted">—</span>
			}
		</td>
		<td class="col-erp code-cell">@autosaveInput("/prodotti/field", i64(it.ID), "alias", it.CodeAlias, "Codice ERP", "", false, templ.Attributes{"maxlength": fmt.Sprint(service.MaxERPCodeLen)})</td>
		<td class="wide">@autosaveField("/prodotti/field", i64(it.ID), "description", it.Description, "Descrizione", "", focus)</td>
		<td>@autosaveField("/prodotti/field", i64(it.ID), "winery", it.Winery, "Cantina", "", false)</td>
		<td>@autosaveField("/prodotti/field", i64(it.ID), "area", it.Area, "Area", "", false)</td>
		<td class="num">@deleteRowButton("/prodotti/delete", i64(it.ID), "Eliminare questo prodotto? Gli ordini già creati non cambiano.")</td>
	</tr>
}

// ── Statistiche ──────────────────────────────────────────────────────────────

templ StatistichePage(st *service.Stats) {
	@Layout("Statistiche", "statistiche") {
		<h2>Statistiche</h2>
		<div class="metrics">
			<div class="metric"><span>Campagne totali</span><b>{ itoa(st.Campagne) }</b></div>
			<div class="metric"><span>Risposte totali</span><b>{ itoa(st.Risposte) }</b></div>
			<div class="metric"><span>Utenti unici</span><b>{ itoa(st.Utenti) }</b></div>
		</div>
		<hr/>
		<h3>Inserzioni più discusse</h3>
		if len(st.PiuDiscusse) == 0 {
			@Alert("info", "Nessun dato.")
		} else {
			<table class="table">
				<thead><tr><th>Inserzione</th><th>Venditore</th><th>Data</th><th class="num">Risposte</th></tr></thead>
				<tbody>
					for _, d := range st.PiuDiscusse {
						<tr><td class="title-cell">{ noEmoji(d.Inserzione) }</td><td>{ noEmoji(d.Venditore) }</td><td>{ d.Data }</td><td class="num">{ itoa(d.Risposte) }</td></tr>
					}
				</tbody>
			</table>
		}
		<h3>Utenti più attivi</h3>
		<table class="table">
			<thead><tr><th>Utente</th><th class="num">Risposte</th></tr></thead>
			<tbody>
				for _, u := range st.UtentiAttivi {
					<tr><td class="title-cell">{ u.Utente }</td><td class="num">{ itoa(u.Risposte) }</td></tr>
				}
			</tbody>
		</table>
	}
}
